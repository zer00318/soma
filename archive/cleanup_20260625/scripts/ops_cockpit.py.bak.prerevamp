"""TRACE cockpit — the founder's window. SHOWS, doesn't just tell.

Embeds the live 3D world, shows the actual photos being identified with their
names, a real progress bar that moves, and auto-detected phone state. Reads
the goal/plan/status from ops/cockpit/*.json. Serves crop thumbnails from a
sandboxed /img endpoint. Every section crash-proof.
"""
import glob
import html
import http.server
import io
import json
import os
import time
import urllib.parse
import urllib.request

sys_path_dir = os.path.dirname(os.path.abspath(__file__))
import sys
if sys_path_dir not in sys.path:
    sys.path.insert(0, sys_path_dir)
try:
    import ask_home
except Exception:
    ask_home = None

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CK = os.path.join(REPO, "ops", "cockpit")
WALKS = os.path.join(REPO, "data", "walks")
ACTIVE_WALK = "walk_outside_20260614"  # today's test; falls back to the home capture


def _active_capture():
    """Point the cockpit at the walk we're testing now, if it has a memory dir."""
    p = os.path.join(WALKS, ACTIVE_WALK)
    if os.path.isdir(os.path.join(p, "memory")):
        return p
    return os.path.join(WALKS, "home_capture_20260613")


CAPTURE = _active_capture()
WORK = os.path.join(CAPTURE, "work")
# Live pipeline logs (today's run) — surfaced in the "What's running" panel.
KF_LOG = "/tmp/kf_walk.log"
FIN_LOG = "/tmp/finish_walk.log"
def _best_memory():
    """Prefer the two-channel keyframe memory (reads words + describes scenes);
    fall back to the older describe-only files until it's built."""
    mdir = os.path.join(CAPTURE, "memory")
    for name in ("world_memory.json", "kf_memory.json", "memory_full.json", "memory.json"):
        p = os.path.join(mdir, name)
        if os.path.exists(p) and os.path.getsize(p) > 2:
            return p
    return os.path.join(mdir, "memory.json")


MEMORY = _best_memory()
VERIFY_CKPT = os.path.join(WORK, "home_verified.ckpt.ndjson")
VERIFY_TOTAL = 708
KNOWN_WRONG = {"diaper", "videotape", "cloak", "bedpan", "igniter", "hairnet", "puppet", "razorblade"}
CORRECTIONS = os.path.join(CK, "corrections.json")
GOLD = os.path.join(REPO, "evaluation", "ras", "walk_outside_20260614.gold.json")
SCOREBOARD = os.path.join(CK, "scoreboard.jsonl")
BASELINE_RAS = -4.0  # the honest floor this sprint started from (2026-06-17)

_phone_cache = {"t": 0.0, "val": False}


def load_corrections():
    try:
        return json.load(open(CORRECTIONS))
    except Exception:
        return {}


def save_correction(crop, verdict, correction):
    data = load_corrections()
    data[crop] = {"verdict": verdict, "correction": correction, "t": time.strftime("%Y-%m-%d %H:%M")}
    tmp = CORRECTIONS + ".tmp"
    json.dump(data, open(tmp, "w"), indent=2)
    os.replace(tmp, CORRECTIONS)


def read_json(name, default):
    try:
        with open(os.path.join(CK, name)) as f:
            return json.load(f)
    except Exception:
        return default


def load_scoreboard():
    """The per-question results of the most recent full score (durable copy)."""
    rows = []
    try:
        for line in open(SCOREBOARD):
            line = line.strip()
            if line:
                rows.append(json.loads(line))
    except Exception:
        return []
    return rows


def load_gold():
    try:
        return json.load(open(GOLD)).get("items", {})
    except Exception:
        return {}


def tally(rows):
    c = sum(1 for r in rows if r.get("verdict") == "correct")
    w = sum(1 for r in rows if r.get("verdict") == "wrong")
    m = sum(1 for r in rows if r.get("verdict") == "miss")
    hard = [r for r in rows if not r.get("pending")]
    hc = sum(1 for r in hard if r.get("verdict") == "correct")
    hw = sum(1 for r in hard if r.get("verdict") == "wrong")
    answered = hc + hw
    ras = round((hc - hw) / max(len(hard), 1) * 100, 1) if hard else 0.0
    halluc = round(hw / answered * 100, 1) if answered else 0.0
    return {"correct": c, "wrong": w, "miss": m, "ras": ras, "halluc": halluc, "n": len(rows)}


def http_ok(url):
    try:
        with urllib.request.urlopen(url, timeout=2) as r:
            return r.status == 200
    except Exception:
        return False


def phone_connected():
    if time.time() - _phone_cache["t"] < 30:
        return _phone_cache["val"]
    val = False
    try:
        out = os.popen("xcrun devicectl list devices 2>/dev/null").read().lower()
        val = ("iphone" in out) and ("available" in out or "connected" in out)
    except Exception:
        pass
    _phone_cache.update(t=time.time(), val=val)
    return val


def verify_progress():
    try:
        if not os.path.exists(VERIFY_CKPT):
            return None
        keys = set()
        for line in open(VERIFY_CKPT):
            try:
                keys.add(json.loads(line).get("_ckpt_key"))
            except Exception:
                pass
        return len(keys), VERIFY_TOTAL, os.path.getmtime(VERIFY_CKPT)
    except Exception:
        return None


def latest_labels():
    for name in ("home_verified.json", "run_clean_labels.json", "run_clustered.json"):
        p = os.path.join(WORK, name)
        if os.path.exists(p):
            try:
                d = json.load(open(p))
                return [r for r in d if isinstance(r, dict) and r.get("word")]
            except Exception:
                continue
    return []


def showcase(n=15):
    labels = latest_labels()
    # spread: most-seen first, but ensure we include some flagged-wrong ones honestly
    labels = sorted(labels, key=lambda r: -(r.get("count") or 1))
    picked, seen = [], set()
    for r in labels:
        w = r.get("word")
        if w in seen:
            continue
        seen.add(w)
        crop = r.get("crop_path") or r.get("crop")
        if crop and os.path.exists(crop):
            picked.append((w, crop))
        if len(picked) >= n:
            break
    return picked


def thumb_bytes(path, box=150):
    from PIL import Image
    rp = os.path.realpath(path)
    if not rp.startswith(os.path.realpath(CAPTURE)):
        return None
    im = Image.open(rp).convert("RGB")
    im.thumbnail((box, box))
    buf = io.BytesIO()
    im.save(buf, format="JPEG", quality=80)
    return buf.getvalue()


def section(fn):
    try:
        return fn()
    except Exception as exc:
        return "<p style='color:#777'>n/a (%s)</p>" % html.escape(type(exc).__name__)


class Cockpit(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _json_out(self, obj):
        out = json.dumps(obj).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(out)))
        self.end_headers()
        self.wfile.write(out)

    def do_POST(self):
        try:
            n = int(self.headers.get("Content-Length", 0))
            payload = json.loads(self.rfile.read(n) or b"{}")
            if self.path.startswith("/ask"):
                q = payload.get("question", "").strip()
                if not q or ask_home is None:
                    return self._json_out({"answer": "Ask me anything about your home.", "scenes": []})
                res = ask_home.ask(q, _best_memory())
                scenes = [{"t": s.get("t"), "frame": s.get("frame")} for s in res.get("scenes", [])]
                return self._json_out({"answer": res.get("answer", ""), "scenes": scenes})
            if self.path.startswith("/note"):
                msg = payload.get("message", "").strip()
                if msg:
                    with open(os.path.join(CK, "founder_notes.ndjson"), "a") as f:
                        f.write(json.dumps({"ts": time.strftime("%Y-%m-%d %H:%M:%S"), "message": msg}) + "\n")
                return self._json_out({"ok": True})
            save_correction(payload.get("crop", ""), payload.get("verdict", ""), payload.get("correction", ""))
            return self._json_out({"ok": True, "reviewed": len(load_corrections())})
        except Exception as exc:
            return self._json_out({"answer": "n/a (%s)" % type(exc).__name__, "scenes": []})

    def do_GET(self):
        if self.path.startswith("/img"):
            return self.serve_img()
        if self.path.startswith("/review"):
            body = self.review_page().encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        body = self.page().encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def serve_img(self):
        try:
            q = urllib.parse.urlparse(self.path).query
            p = urllib.parse.parse_qs(q).get("p", [""])[0]
            data = thumb_bytes(p)
            if not data:
                self.send_response(404); self.end_headers(); return
            self.send_response(200)
            self.send_header("Content-Type", "image/jpeg")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        except Exception:
            self.send_response(500); self.end_headers()

    def page(self):
        css = (
            "body{background:#0d0d0f;color:#e6e6e6;font-family:-apple-system,Segoe UI,Arial,sans-serif;margin:0;padding:26px 30px;line-height:1.5}"
            "h1{font-size:20px;margin:0 0 4px;color:#fff}.goal{color:#bdbdbd;font-size:14px;margin:0 0 16px;max-width:920px}"
            ".bar{height:13px;background:#222;border-radius:7px;overflow:hidden;max-width:920px;margin:6px 0 8px}"
            ".fill{height:100%;background:linear-gradient(90deg,#2f7d4f,#7be08f);text-align:right;color:#04210f;font-size:10px;font-weight:700;padding-right:7px;line-height:13px}"
            "h2{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#7db4ff;margin:24px 0 9px}"
            ".card{background:#16161a;border:1px solid #24242a;border-radius:10px;padding:13px 15px;margin:8px 0;max-width:920px}"
            ".now{border-left:3px solid #ffd24a}.ask{border-left:3px solid #ff9d3a;background:#1c1813}.ok{border-left:3px solid #2f7d4f}"
            ".chip{display:inline-block;font-size:11px;font-weight:700;padding:2px 9px;border-radius:20px;margin-right:10px}"
            ".mile{display:flex;align-items:center;padding:6px 0;border-bottom:1px solid #1c1c20;max-width:920px}.mnote{color:#8a8a8a;font-size:12px;margin-left:8px}"
            ".wall{color:#d98a8a;font-size:13px;margin:6px 0;max-width:920px}.wall b{color:#ffb3b3}.re{color:#8fd49f}"
            ".muted{color:#8a8a8a;font-size:13px}.big{font-size:15px;color:#fff}"
            ".grid{display:flex;flex-wrap:wrap;gap:10px;max-width:920px}"
            ".obj{width:120px;text-align:center}.obj img{width:120px;height:120px;object-fit:cover;border-radius:8px;border:1px solid #333}"
            ".lab{font-size:12px;margin-top:3px}.good{color:#9fe0af}.bad{color:#ff8f8f}"
            "iframe{width:920px;height:430px;border:1px solid #24242a;border-radius:10px;background:#000}"
        )
        # Real auto-refresh (every 6s) — but never interrupt you while you're
        # typing a question or while an answer is on screen.
        refresh = ("<script>setInterval(function(){var q=document.getElementById('q');"
                   "var a=document.getElementById('ans');var nt=document.getElementById('note');"
                   "if(q&&(q===document.activeElement||q.value))return;"
                   "if(nt&&(nt===document.activeElement||nt.value))return;"
                   "if(a&&a.innerHTML.trim())return;location.reload();},6000);</script>")
        parts = ["<html><head><title>TRACE</title><style>%s</style>%s</head><body>" % (css, refresh)]
        for fn in (self.header, self.right_now, self.critic_panel, self.scoreboard,
                   self.dynamic_asks, self.plan, self.ask_box, self.note_box):
            parts.append(section(fn))
        parts.append("<p class='muted' style='margin-top:28px'>This page is how the lead talks to you and shows you the work. "
                     "It refreshes itself every few seconds. You never type to the lead — just act on “What I need from you”.</p></body></html>")
        return "".join(parts)

    def header(self):
        plan = read_json("plan.json", {})
        rows = load_scoreboard()
        t = tally(rows) if rows else None
        prog = read_json("eval_progress.json", {})
        out = ["<h1>TRACE — where we are</h1><div class='goal'>%s</div>"
               % html.escape(plan.get("goal", ""))]
        if t and t["n"]:
            trend = t["ras"] - BASELINE_RAS
            arrow = ("&#9650; up %.0f" % trend) if trend > 0 else (
                "&#9660; down %.0f" % (-trend) if trend < 0 else "flat")
            tcol = "#7be08f" if trend > 0 else ("#ff8f8f" if trend < 0 else "#9a9a9a")
            out.append(
                "<div class='card ok' style='max-width:920px'>"
                "<div style='display:flex;gap:26px;flex-wrap:wrap;align-items:center'>"
                "<div><div class='muted'>Questions it got RIGHT</div>"
                "<div style='font-size:30px;color:#7be08f;font-weight:700'>%d<span style='font-size:16px;color:#8a8a8a'> / %d</span></div></div>"
                "<div><div class='muted'>Times it MADE SOMETHING UP</div>"
                "<div style='font-size:30px;color:%s;font-weight:700'>%d</div></div>"
                "<div><div class='muted'>Honest 'I don't know' (a win, not a loss)</div>"
                "<div style='font-size:30px;color:#7db4ff;font-weight:700'>%d</div></div>"
                "<div><div class='muted'>Score (right &minus; made-up)</div>"
                "<div style='font-size:30px;font-weight:700;color:%s'>%+.0f <span style='font-size:14px'>%s</span></div>"
                "<div class='muted'>from %+.0f at the start</div></div>"
                "</div></div>"
                % (t["correct"], t["n"], ("#ff8f8f" if t["wrong"] else "#7be08f"),
                   t["wrong"], t["miss"], tcol, t["ras"], arrow, BASELINE_RAS))
        # Live re-measurement banner — prefer eval_live.json (the resumable runner that
        # carries an ETA); fall back to eval_progress.json. Shows TIME LEFT so a long
        # background score isn't a black box (each Q is ~30-80s of local LLM work).
        live = read_json("eval_live.json", {})
        src = live if (live.get("total") and live.get("done", 0) < live.get("total")) else prog
        fresh = (time.time() - src.get("updated_epoch", 0)) < 600 if src else False
        if src and src.get("total") and src.get("done", 0) < src.get("total") and fresh:
            eta = src.get("eta_human")
            avg = src.get("avg_s_per_q")
            extra = ""
            if eta:
                extra = " &middot; ~<b>%s</b> left" % eta
                if avg:
                    extra += " <span class='muted'>(~%.0fs per question — it re-derives each answer blind, then a separate judge grades it)</span>" % avg
            out.append("<div class='card now' style='max-width:920px'>&#9203; Scoring right now: "
                       "<b>%d / %d</b> questions%s</div>"
                       % (src.get("done", 0), src.get("total", 0), extra))
        out.append("<div class='muted' style='max-width:920px;margin-top:6px'>%s</div>"
                   % html.escape(plan.get("headline_metric", "")))
        return "".join(out)

    def scoreboard(self):
        rows = load_scoreboard()
        if not rows:
            return ""
        gold = load_gold()
        icon = {"correct": ("&#10003;", "#7be08f", "got it right"),
                "wrong": ("&#10007;", "#ff8f8f", "MADE UP / wrong"),
                "miss": ("&#129300;", "#7db4ff", "honestly said ‘I don’t know’")}
        out = ["<h2>Question by question — the actual test</h2>",
               "<div class='muted' style='max-width:920px;margin-bottom:8px'>Green = right. "
               "Red = it made something up (the worst case — we drive these to zero). "
               "Blue = it honestly refused (a WIN here). For red rows I show what the true answer was.</div>"]
        for r in rows:
            v = r.get("verdict", "miss")
            mark, col, lab = icon.get(v, icon["miss"])
            g = gold.get(str(r.get("i")), {})
            q = g.get("q") or r.get("question", "")
            ans = (r.get("answer", "") or "").strip().replace("\n", " ")
            if len(ans) > 200:
                ans = ans[:200] + "…"
            truth = ""
            if v == "wrong" and g.get("gold"):
                tg = g["gold"].split(".")[0].split("(")[0].strip()
                truth = ("<div class='muted' style='margin-top:3px'><b style='color:#ffd24a'>"
                         "True answer:</b> %s</div>" % html.escape(tg[:160]))
            out.append(
                "<div class='card' style='border-left:3px solid %s;max-width:920px'>"
                "<div><span style='color:%s;font-weight:700;font-size:15px'>%s</span> "
                "<b>Q%s. %s</b></div>"
                "<div style='margin-top:4px'>It answered: <span class='muted'>%s</span></div>%s</div>"
                % (col, col, mark, r.get("i"), html.escape(q), html.escape(ans), truth))
        return "".join(out)

    def critic_panel(self):
        c = read_json("critic.json", {})
        if not c:
            return ("<h2>Independent critic (unbiased outside view)</h2>"
                    "<div class='card'>The independent critic hasn't run yet. It reads the raw "
                    "files (not my summary) and judges honestly whether we're really progressing. "
                    "Its verdict will appear here.</div>")
        verdict = c.get("verdict", c)
        dr = (verdict.get("doing_it_right") or "?").upper()
        drcol = {"YES": "#7be08f", "MOSTLY": "#9fe0af", "MIXED": "#ffd24a", "NO": "#ff8f8f"}.get(dr, "#9a9a9a")
        out = ["<h2>Independent critic — the unbiased outside view</h2>",
               "<div class='card' style='border-left:3px solid %s;max-width:920px'>" % drcol,
               "<div class='muted'>A separate set of reviewers reads the RAW files, not my summary, "
               "and I cannot edit what it says. It answers: are we doing this right?</div>",
               "<div style='font-size:16px;margin:8px 0'><b>Doing it right? "
               "<span style='color:%s'>%s</span></b> &nbsp; %s</div>"
               % (drcol, dr, html.escape(verdict.get("headline", "")))]
        plain = verdict.get("plain_english_for_founder", "")
        if plain:
            out.append("<div style='margin:8px 0'>%s</div>" % html.escape(plain))
        for key, title, col in (("whats_real", "What's genuinely real", "#7be08f"),
                                ("whats_suspect", "What to be skeptical of", "#ffd24a"),
                                ("biggest_risks", "Biggest risks", "#ff8f8f"),
                                ("course_corrections", "What it says to change", "#7db4ff")):
            items = verdict.get(key) or []
            if items:
                out.append("<div style='margin-top:6px'><b style='color:%s'>%s:</b><ul style='margin:4px 0'>%s</ul></div>"
                           % (col, title, "".join("<li>%s</li>" % html.escape(str(x)) for x in items)))
        gen = c.get("generated") or c.get("model") or ""
        if gen:
            out.append("<div class='muted' style='margin-top:6px'>%s</div>" % html.escape(str(gen)))
        out.append("</div>")
        return "".join(out)

    def note_box(self):
        js = ("function sendNote(){var t=document.getElementById('note');var v=t.value.trim();if(!v)return;"
              "fetch('/note',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:v})})"
              ".then(r=>r.json()).then(d=>{document.getElementById('notestatus').textContent='Sent to the lead — I read this every turn. ';t.value='';});}")
        return ("<h2>Talk to me (type here)</h2><script>%s</script>"
                "<div class='card now'>"
                "<textarea id='note' placeholder='Type ANYTHING for me — answers, corrections, ideas. This goes straight to the lead.' "
                "style='width:97%%;height:74px;background:#0d0d0f;color:#fff;border:1px solid #444;border-radius:7px;padding:10px;font-size:15px;font-family:inherit'></textarea>"
                "<div style='margin-top:8px'><button onclick='sendNote()' "
                "style='padding:10px 20px;background:#7db4ff;color:#04210f;border:0;border-radius:7px;font-size:15px;cursor:pointer;font-weight:700'>Send to lead</button>"
                "<span id='notestatus' class='good' style='margin-left:12px'></span></div></div>"
                % js)

    def ask_box(self):
        has_mem = os.path.exists(MEMORY)
        sub = ("Ask anything — where things are, what a label said, what's in a room." if has_mem
               else "Building your home's memory…")
        js = """
        function askHome(){
          var q=document.getElementById('q').value; if(!q)return;
          document.getElementById('ans').innerHTML='…thinking, looking back through your home…';
          fetch('/ask',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question:q})})
          .then(r=>r.json()).then(d=>{
            var h='<div class="abig">'+d.answer+'</div>';
            if((d.scenes||[]).length){h+='<div class="muted" style="margin-top:10px">What was really there — MY test check only. The product stores none of this; it answers from words alone.</div><div class="proof">';
            (d.scenes||[]).forEach(s=>{h+='<a href="/img?p='+encodeURIComponent(s.frame)+'" target="_blank"><img src="/img?p='+encodeURIComponent(s.frame)+'"></a>';});h+='</div>';}
            document.getElementById('ans').innerHTML=h;
          });
        }
        function ek(e){if(e.key==='Enter')askHome();}
        """
        return ("<h2>Ask your home</h2><script>%s</script>"
                "<div class='card now'><input id='q' placeholder='%s' onkeydown='ek(event)' "
                "style='width:74%%;background:#0d0d0f;color:#fff;border:1px solid #444;border-radius:7px;padding:10px;font-size:15px'>"
                "<button onclick='askHome()' style='padding:10px 18px;margin-left:8px;background:#2f7d4f;color:#fff;border:0;border-radius:7px;font-size:15px;cursor:pointer'>Ask</button>"
                "<div id='ans' style='margin-top:12px'></div></div>"
                "<style>.abig{font-size:16px;color:#fff}.proof{display:flex;gap:8px;margin-top:10px}"
                ".proof img{width:160px;height:110px;object-fit:cover;border-radius:8px;border:1px solid #333}</style>"
                % (js, html.escape(sub)))

    def right_now(self):
        s = read_json("status.json", {})
        out = ["<h2>What I'm doing</h2><div class='card now'><div class='big'>%s</div>"
               "<div class='muted' style='margin-top:7px'><b>Next:</b> %s</div></div>"
               % (html.escape(s.get("now", "—")), html.escape(s.get("next", "—")))]
        # Checks / Captures / Attacks — the chess discipline, shown plainly.
        triad = [("Check", "what's broken or blocking right now", s.get("check"), "#ff8f8f"),
                 ("Capture", "the most valuable thing I'm finishing now", s.get("capture"), "#9fe0af"),
                 ("Attack", "a problem I'm heading off before it costs hours", s.get("attack"), "#ffd24a")]
        cells = []
        for name, sub, val, col in triad:
            if not val:
                continue
            cells.append("<div class='card' style='border-left:3px solid %s'>"
                         "<b style='color:%s'>%s</b> <span class='muted'>— %s</span>"
                         "<div style='margin-top:5px'>%s</div></div>"
                         % (col, col, name, html.escape(sub), html.escape(val)))
        if cells:
            out.append("<div style='margin-top:6px'>%s</div>" % "".join(cells))
        return "".join(out)

    def dynamic_asks(self):
        data = read_json("asks.json", {})
        asks = data.get("asks", [])
        out = ["<h2>What I need from you</h2>"]
        if not asks:
            out.append("<div class='card ok'>Nothing needed right now — I'll put it here when I do.</div>")
        for a in asks:
            pieces = ["<b>%s</b>" % html.escape(a.get("title", ""))]
            if a.get("why"):
                pieces.append("<div class='muted' style='margin-top:4px'>Why: %s</div>" % html.escape(a["why"]))
            if a.get("how"):
                pieces.append("<div class='muted'>How: %s</div>" % html.escape(a["how"]))
            if a.get("done_when"):
                pieces.append("<div class='muted'>Done when: %s</div>" % html.escape(a["done_when"]))
            out.append("<div class='card ask'>%s</div>" % "".join(pieces))
        return "".join(out)

    def show_world(self):
        if not http_ok("http://127.0.0.1:8777/world"):
            return "<h2>Your home in 3D</h2><div class='card ask'>The 3D world server is down — I'm restarting it.</div>"
        return ("<h2>Your home in 3D (drag to look around)</h2>"
                "<iframe src='http://localhost:8777/world3d'></iframe>")

    def show_objects(self):
        items = showcase()
        if not items:
            return ""
        out = ["<h2>What it found in your home (actual photos) &nbsp; "
               "<a href='/review' style='font-size:13px;color:#ffd24a'>→ help me: tick/cross the full list</a></h2>"
               "<div class='grid'>"]
        for word, crop in items:
            wrong = word in KNOWN_WRONG
            mark = " ✗ likely wrong" if wrong else ""
            cls = "bad" if wrong else "good"
            src = "/img?p=" + urllib.parse.quote(crop)
            out.append("<div class='obj'><img src='%s' loading='lazy'><div class='lab %s'>%s%s</div></div>"
                       % (src, cls, html.escape(word), mark))
        out.append("</div><div class='muted' style='margin-top:6px'>Green = looks right to me. Red = I can see it's a misread (fabric, a box, etc).</div>")
        return "".join(out)

    def plan(self):
        plan = read_json("plan.json", {})
        chip = {"done": ("#1f6f3f", "#7be08f", "done"), "now": ("#7a5a0a", "#ffd24a", "doing now"),
                "next": ("#1d3a5c", "#7db4ff", "next"), "later": ("#2b2b2b", "#9a9a9a", "later"),
                "goal": ("#5a4a0a", "#ffe27a", "the goal")}
        out = ["<h2>The plan — beelining to the goal</h2>"]
        for m in plan.get("milestones", []):
            bg, fg, lab = chip.get(m.get("state"), ("#2b2b2b", "#aaa", m.get("state", "")))
            note = (" <span class='mnote'>%s</span>" % html.escape(m["note"])) if m.get("note") else ""
            out.append("<div class='mile'><span class='chip' style='background:%s;color:%s'>%s</span><span>%s</span>%s</div>"
                       % (bg, fg, lab, html.escape(m.get("name", "")), note))
        for w in plan.get("walls_hit", []):
            out.append("<div class='wall'>&#128679; <b>%s</b><br>&#8627; <span class='re'>%s</span></div>"
                       % (html.escape(w.get("wall", "")), html.escape(w.get("reroute", ""))))
        return "".join(out)

    def review_page(self):
        labels = latest_labels()
        # one card per detected object (dedup by crop), most-seen first
        seen, items = set(), []
        for r in sorted(labels, key=lambda r: -(r.get("count") or 1)):
            crop = r.get("crop_path") or r.get("crop")
            if not crop or crop in seen or not os.path.exists(crop):
                continue
            seen.add(crop)
            items.append((r.get("word", ""), crop))
        corr = load_corrections()
        done = len(corr)
        css = (
            "body{background:#0d0d0f;color:#e6e6e6;font-family:-apple-system,Arial,sans-serif;margin:0;padding:20px}"
            "h1{font-size:18px}.bar{position:sticky;top:0;background:#0d0d0f;padding:10px 0;border-bottom:1px solid #222;z-index:5}"
            ".grid{display:flex;flex-wrap:wrap;gap:12px;margin-top:14px}"
            ".rv{width:170px;background:#16161a;border:2px solid #24242a;border-radius:10px;padding:8px}"
            ".rv.ok{border-color:#2f7d4f}.rv.bad{border-color:#b3432f}"
            ".rv img{width:154px;height:154px;object-fit:cover;border-radius:6px}"
            ".lab{font-size:13px;margin:5px 0;font-weight:600}"
            ".btns button{font-size:15px;width:48%;padding:5px;border:0;border-radius:6px;cursor:pointer}"
            ".yes{background:#1f6f3f;color:#fff}.no{background:#5c1414;color:#fff}"
            "input{width:100%;margin-top:6px;background:#0d0d0f;color:#fff;border:1px solid #444;border-radius:6px;padding:6px;font-size:13px}"
            "a{color:#7db4ff}"
        )
        js = """
        function send(crop,verdict,corr,card){
          fetch('/save',{method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({crop:crop,verdict:verdict,correction:corr||''})})
          .then(r=>r.json()).then(d=>{document.getElementById('cnt').textContent=d.reviewed;});
        }
        function yes(c,card){card.className='rv ok';card.querySelector('.corr').style.display='none';send(c,'ok','',card);}
        function no(c,card){card.className='rv bad';card.querySelector('.corr').style.display='block';card.querySelector('.corr').focus();}
        function fix(c,card){send(c,'wrong',card.querySelector('.corr').value,card);}
        """
        out = ["<html><head><title>Review</title><style>%s</style><script>%s</script></head><body>" % (css, js)]
        out.append("<div class='bar'><h1>Review what I found in your home &nbsp; "
                   "<span style='font-size:14px;color:#8a8a8a'>reviewed <b id='cnt'>%d</b> of %d &nbsp;·&nbsp; "
                   "<a href='/'>&larr; back</a></span></h1>"
                   "<div style='font-size:13px;color:#8a8a8a'>Tick if the name is right. Cross if wrong, then type what it actually is "
                   "(if several things are in the photo, name the main one and note the others). Saves as you go.</div></div>")
        out.append("<div class='grid'>")
        for word, crop in items:
            c = corr.get(crop, {})
            cls = "ok" if c.get("verdict") == "ok" else ("bad" if c.get("verdict") == "wrong" else "")
            cval = html.escape(c.get("correction", "") or "")
            disp = "block" if c.get("verdict") == "wrong" else "none"
            src = "/img?p=" + urllib.parse.quote(crop)
            cj = json.dumps(crop)
            out.append(
                "<div class='rv %s'><img src='%s' loading='lazy'><div class='lab'>%s</div>"
                "<div class='btns'><button class='yes' onclick='yes(%s,this.closest(\".rv\"))'>&#10003;</button> "
                "<button class='no' onclick='no(%s,this.closest(\".rv\"))'>&#10007;</button></div>"
                "<input class='corr' style='display:%s' placeholder='what is it actually?' value='%s' "
                "onblur='fix(%s,this.closest(\".rv\"))' onkeydown='if(event.key==\"Enter\")this.blur()'></div>"
                % (cls, src, html.escape(word), cj, cj, disp, cval, cj))
        out.append("</div></body></html>")
        return "".join(out)

    def _tail(self, path, n=1):
        try:
            with open(path) as f:
                lines = [l.rstrip() for l in f if l.strip()]
            return lines[-n:] if lines else []
        except Exception:
            return []

    def running(self):
        """Live view of today's walk pipeline — the real tasks, as they run."""
        out = ["<h2>What's running now (live)</h2>"]
        kf = []
        try:
            with open(KF_LOG) as f:
                kf = f.readlines()
        except Exception:
            pass
        # caption+read step: parse [n/m] progress and the WROTE completion marker.
        done = total = 0
        for l in kf:
            m = __import__("re").match(r"\[(\d+)/(\d+)\]", l.strip())
            if m:
                done, total = int(m.group(1)), int(m.group(2))
        cap_done = any("WROTE" in l for l in kf)
        fin = ""
        try:
            fin = open(FIN_LOG).read()
        except Exception:
            pass
        memdir = os.path.join(CAPTURE, "memory")
        world_ready = os.path.exists(os.path.join(memdir, "world_memory.json"))
        transcript_ready = os.path.exists(os.path.join(memdir, "transcript.txt"))
        fin_ok = "FINISHED_OK" in fin

        def step(label, state, detail=""):
            icon = {"done": "✅", "run": "⏳", "wait": "•"}[state]
            col = {"done": "#9fe0af", "run": "#ffd24a", "wait": "#8a8a8a"}[state]
            d = (" <span class='muted'>— %s</span>" % html.escape(detail)) if detail else ""
            return ("<div class='mile'><span style='color:%s;margin-right:8px'>%s</span>"
                    "<span>%s</span>%s</div>" % (col, icon, html.escape(label), d))

        # Step 1: turn looking into words (the slow one)
        if cap_done:
            rows = [step("Turn looking into words (read text + describe each moment)", "done",
                         "%d moments" % (total or done))]
        elif total:
            pct = min(100, int(done * 100 / max(1, total)))
            rows = [step("Turn looking into words (read text + describe each moment)", "run",
                         "moment %d of %d" % (done, total)),
                    "<div class='bar' style='margin:4px 0 8px'><div class='fill' style='width:%d%%'>%d%%</div></div>" % (pct, pct)]
        else:
            rows = [step("Turn looking into words (read text + describe each moment)", "run", "starting…")]
        # Step 2: merge into one deduplicated walk-memory
        if world_ready:
            rows.append(step("Merge into ONE deduplicated walk-memory", "done"))
        elif cap_done:
            rows.append(step("Merge into ONE deduplicated walk-memory", "run", "consolidating…"))
        else:
            rows.append(step("Merge into ONE deduplicated walk-memory", "wait"))
        # Step 3: voice -> text
        if transcript_ready:
            rows.append(step("Turn your voice into text (audio decoded then discarded)", "done"))
        elif "STEP 3" in fin:
            rows.append(step("Turn your voice into text (audio decoded then discarded)", "run", "transcribing…"))
        else:
            rows.append(step("Turn your voice into text (audio decoded then discarded)", "wait"))

        out.append("<div class='card'>%s</div>" % "".join(rows))
        if world_ready and (transcript_ready or fin_ok):
            out.append("<div class='card ok'><b style='color:#7be08f;font-size:16px'>READY — ask away.</b> "
                       "Type your questions in the box below. The product answers from its words alone; "
                       "the photo it shows is MY truth-check only, never stored.</div>")
        elif kf:
            out.append("<div class='muted'>This is the dev rig batch-processing the whole clip to measure quality. "
                       "The real product does this live and only on what you dwell on — not all-at-once.</div>")
        else:
            out.append("<div class='card muted'>No walk processing right now.</div>")
        return "".join(out)


if __name__ == "__main__":
    srv = http.server.ThreadingHTTPServer(("0.0.0.0", 8788), Cockpit)
    print("cockpit on :8788")
    srv.serve_forever()
