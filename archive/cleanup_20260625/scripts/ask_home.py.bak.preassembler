#!/usr/bin/env python3
"""Ask your home a question. Route it to the memory layer that holds the answer
(keyframe OCR+caption for reading/temporal, the deduplicated world inventory for
counting), let gemma reason over the read text with its own world knowledge to
produce a concrete, cited answer — while keeping the honest-refusal default.

This is the product: capture -> a vision model reads and describes the world ->
you ask anything, answered from the words it remembered, with the frame as proof.
"""
from __future__ import annotations

import argparse
import json
import math
import os
import re
import sys
import urllib.request

# build_temporal_index is created in the same task but ask_home must still load
# and answer reading/counting questions if that file is absent or broken.
try:
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import build_temporal_index as _temporal
except Exception:
    _temporal = None

# Semantic (multilingual-embedding) retrieval — the memory-finder. Optional: if the
# embedder/model is unavailable, _sem_retrieve returns None and we fall back to the
# IDF token-overlap retriever, so an answer is never blocked on it.
try:
    import semantic_index as _semantic
except Exception:
    _semantic = None

# ── Specialist modules (defensive imports — a missing module never crashes ask_home) ──
try:
    import counting_specialist as _counting_specialist
except Exception:
    _counting_specialist = None

try:
    import temporal_specialist as _temporal_specialist
except Exception:
    _temporal_specialist = None

try:
    import screen_reader as _screen_reader
except Exception:
    _screen_reader = None

try:
    import audio_events as _audio_events
except Exception:
    _audio_events = None

STOP = set("the a an of in on at is are was were i my me you your it its to for and "
           "with what where when who how do does did can could there here that this".split())


# --------------------------------------------------------------------------- #
# Memory loading: resolve BOTH file shapes, normalize OCR, locate the sibling.
# --------------------------------------------------------------------------- #
def load_memory_records(records):
    """Normalize an already-parsed keyframe LIST in place and return it.

    Always computes _ocr_txt from each record's ocr list (so pre-baked-description
    items still expose their read text), and synthesizes description only when it
    is absent. Empty/whitespace OCR fragments are dropped.
    """
    for m in records:
        ocr = m.get("ocr") or []
        if isinstance(ocr, list):
            ocr_txt = "; ".join(x for x in ocr if x and str(x).strip())
        else:
            ocr_txt = str(ocr)
        m["_ocr_txt"] = ocr_txt
        if "description" not in m:
            cap = m.get("caption", "")
            m["description"] = (cap + (("  TEXT: " + ocr_txt) if ocr_txt else "")).strip()
    return records


def load_memory(path):
    """Back-compat loader: read a keyframe JSON list from disk and normalize it."""
    try:
        parsed = json.load(open(path))
    except Exception:
        return []
    if not isinstance(parsed, list):
        return []
    return load_memory_records(parsed)


def _resolve_memories(memory_path):
    """Resolve memory_path (kf list OR world dict) to both layers + the kf path.

    Returns {"kf": <list|None>, "world": <list|None>, "kf_path": <str|None>}.
    Parses memory_path exactly once and auto-locates the sibling file so callers
    can pass either world_memory.json or kf_memory.json and get the full picture.
    """
    try:
        parsed = json.load(open(memory_path))
    except Exception:
        return {"kf": None, "world": None, "kf_path": None}

    base = os.path.dirname(os.path.abspath(memory_path))

    # WORLD file: {objects: [...]} — want kf sibling for reading/temporal.
    if isinstance(parsed, dict) and isinstance(parsed.get("objects"), list):
        world = parsed["objects"]
        sib = os.path.join(base, "kf_memory.json")
        if os.path.exists(sib):
            kf = load_memory(sib)
            kf_path = sib
        else:
            kf = None
            kf_path = None
        return {"kf": kf, "world": world, "kf_path": kf_path}

    # KEYFRAME file: list — want world sibling for counting.
    if isinstance(parsed, list):
        kf = load_memory_records(parsed)
        kf_path = os.path.abspath(memory_path)
        world = None
        sib = os.path.join(base, "world_memory.json")
        if os.path.exists(sib):
            try:
                wparsed = json.load(open(sib))
                if isinstance(wparsed, dict) and isinstance(wparsed.get("objects"), list):
                    world = wparsed["objects"]
            except Exception:
                world = None
        return {"kf": kf, "world": world, "kf_path": kf_path}

    return {"kf": None, "world": None, "kf_path": None}


def locate_audio(memory_path):
    """Find audio.wav in the same memory directory as the given memory file.

    NOTE: query time must NOT open this. It exists only so the build step
    (build_audio_events.py) can summarise the wave to audio_events.json once.
    ask_home answers sound-event questions from that cached TEXT log
    (load_audio_events), never from the raw wav — the no-raw-storage contract.
    """
    base = os.path.dirname(os.path.abspath(memory_path))
    p = os.path.join(base, "audio.wav")
    return p if os.path.exists(p) else None


def load_audio_events(memory_path):
    """Load the cached capture-time audio-event log (audio_events.json) for this
    capture. Returns the parsed dict or None.

    This is the ONLY audio source ask_home reads at query time. The raw audio
    wave was analysed ONCE at capture (scripts/build_audio_events.py) into this
    small text log {overall_db, usable_sound, events:[...]}; a sound-event
    question ('was there a child crying?') is answered from these words, NOT by
    re-opening audio.wav. Keeps the audio channel honest and storage-free."""
    base = os.path.dirname(os.path.abspath(memory_path))
    p = os.path.join(base, "audio_events.json")
    if os.path.exists(p):
        try:
            return json.load(open(p))
        except Exception:
            return None
    return None


def load_transcript(memory_path):
    """Locate and parse the sibling voice transcript (transcript.json) for this
    capture. Returns the parsed dict or None. The audio channel is deliberately
    separate from the visual layers so a spoken-word question is never answered
    from what was SEEN."""
    base = os.path.dirname(os.path.abspath(memory_path))
    for name in ("transcript.json",):
        p = os.path.join(base, name)
        if os.path.exists(p):
            try:
                return json.load(open(p))
            except Exception:
                return None
    return None


# --------------------------------------------------------------------------- #
# Retrieval: IDF-weighted overlap over caption + OCR, with numeric awareness.
# --------------------------------------------------------------------------- #
def _tokens(s):
    return re.findall(r"[a-z0-9]+", (s or "").lower())


def _idf(memory):
    """Down-weight words that appear in many scenes (gemma boilerplate like
    'description', 'visible', 'layout', ubiquitous 'wall'/'floor'). Tokens keep
    digits so years/codes (e.g. 1845) stay discriminating."""
    n = max(1, len(memory))
    df = {}
    for m in memory:
        for w in set(_tokens(m.get("description", ""))):
            df[w] = df.get(w, 0) + 1
    return {w: math.log((n + 1) / (c + 1)) for w, c in df.items()}


# --------------------------------------------------------------------------- #
# Attribute-aware re-ranking: prefer the frame that actually shows the asked item.
#
# The retriever (semantic or IDF) ranks by overall text similarity, which on the
# walk pulled the WRONG specific item to the top:
#   - "what colour was the bag?"  -> a stray "gray plastic bag" in a trash bin
#     out-ranked the user's WHITE BACKPACK (whose caption says "backpack", not
#     "bag" — a synonym the bare retriever never bridges).
#   - "what was on the yellow poster?" -> the Robert-Sauer poster's frame calls
#     itself a "signpost"/"billboard" in the caption, so "poster" never matched
#     and the right frame sank.
# Fix: when a question names a distinguishing ATTRIBUTE (a colour/material) and/or
# an object TYPE, boost frames whose caption+OCR actually contain those words (via
# a small synonym map so bag<->backpack, poster<->billboard/sign/mural bridge),
# and reorder the candidate set accordingly — without ever dropping a frame, so
# the provenance leash + grounding gate + honest-refusal default stay intact.
# --------------------------------------------------------------------------- #
COLOUR_WORDS = {
    "white", "black", "gray", "grey", "red", "blue", "green", "yellow",
    "orange", "purple", "pink", "brown", "silver", "gold", "beige", "tan",
    "turquoise", "violet", "maroon", "navy", "cream",
}

MATERIAL_WORDS = {
    "metal", "metallic", "plastic", "wood", "wooden", "glass", "leather",
    "paper", "fabric", "cloth", "steel", "ceramic", "cardboard", "rubber",
    "stone", "concrete",
}

# Object TYPE groups: question word -> the set of caption/OCR words that mean the
# same thing. A frame "matches" a question type if it contains the type word OR
# any synonym. This bridges the captioner's vocabulary (backpack, billboard,
# signpost, mural) to the user's everyday word (bag, poster).
TYPE_SYNONYMS = {
    "bag": {"bag", "backpack", "rucksack", "knapsack", "handbag", "purse", "tote", "satchel"},
    "poster": {"poster", "billboard", "signboard", "signpost", "sign", "mural",
               "plaque", "panel", "placard", "banner", "advertisement", "board"},
    "sign": {"sign", "signboard", "signpost", "poster", "billboard", "placard",
             "plaque", "panel", "notice"},
    "screen": {"screen", "monitor", "display", "laptop", "computer", "phone"},
    "bottle": {"bottle", "flask", "canister"},
    "cart": {"cart", "trolley", "buggy"},
    "bin": {"bin", "can", "trash", "garbage", "dustbin", "rubbish"},
    "door": {"door", "doorway", "gate"},
}


def _count_occurrences(words, text_tokens):
    """How many times any word in `words` appears in the token list `text_tokens`."""
    return sum(1 for t in text_tokens if t in words)


def _question_attributes(question):
    """Pull the distinguishing words out of a question.

    Returns (q_colours, q_materials, q_type_sets). q_type_sets is a list of
    synonym sets — one per object TYPE the question names — so a frame matches a
    type if it contains the type word OR any synonym (bag<->backpack,
    poster<->billboard/signpost/mural). Empty everything == no distinguishing
    attribute, so callers leave retrieval order untouched.
    """
    qtokens = set(re.findall(r"[a-z]+", (question or "").lower()))
    q_colours = qtokens & COLOUR_WORDS
    q_materials = qtokens & MATERIAL_WORDS
    q_type_sets = []
    seen_ids = set()
    for word in qtokens:
        syns = None
        if word in TYPE_SYNONYMS:
            syns = TYPE_SYNONYMS[word]
        else:
            for group in TYPE_SYNONYMS.values():
                if word in group:
                    syns = group
                    break
        if syns is not None and id(syns) not in seen_ids:
            seen_ids.add(id(syns))
            q_type_sets.append(syns)
    return q_colours, q_materials, q_type_sets


def _adjacent(toks, attr_words, type_words, window=2):
    """True if an attribute word appears immediately before a type word ('yellow
    poster', 'white backpack') within `window` tokens. Adjacency is the decisive
    'this frame is the asked item' signal: it separates 'a yellow POSTER' (the asked
    thing) from 'a yellow tactile strip ... a BILLBOARD' (background colour + an
    unrelated surface), which mere co-occurrence in the same frame cannot."""
    pos_t = [i for i, t in enumerate(toks) if t in type_words]
    if not pos_t:
        return False
    pos_a = [i for i, t in enumerate(toks) if t in attr_words]
    return any(0 <= ti - ai <= window for ai in pos_a for ti in pos_t)


def _attribute_boost(scene, q_colours, q_materials, q_type_sets):
    """Score how strongly a frame's caption+OCR matches the question's distinguishing
    words, and report whether it's an unambiguous match for the asked item.

      - type match: +1.5 if the asked type/synonym is present, +0.6 per extra
        occurrence (capped) — a frame that mentions the item repeatedly is the one
        it's actually ABOUT (white backpack ... the backpack), not a one-off liner.
      - colour/material match: +1.0 each, DOUBLED when the asked type is also present.
      - ADJACENCY: +3.0 when an asked colour/material sits right before the asked
        type ('yellow poster', 'white backpack') — the strongest signal, and the one
        that flags an `exact` match for context-focusing.

    Returns (total_score, type_present, exact). `exact` is True only for an
    adjacency hit (colour/material+type questions) or, for a type-only question, a
    strong repeated type mention — that is what restricts the answer context so a
    conflicting item ('gray plastic bag' in a bin) cannot leak in.
    """
    all_types = set()
    for syns in q_type_sets:
        all_types |= syns
    attr_words = q_colours | q_materials

    text = ((scene.get("caption", "") or scene.get("description", "")) + " "
            + (scene.get("_ocr_txt", "") or ""))
    toks = re.findall(r"[a-z]+", text.lower())
    tokset = set(toks)

    type_hits = 0.0
    type_present = False
    type_occ = 0
    for syns in q_type_sets:
        occ = _count_occurrences(syns, toks)
        if occ:
            type_present = True
            type_occ += occ
            type_hits += 1.5 + min(occ - 1, 3) * 0.6

    attr_mult = 2.0 if type_present else 1.0
    colour_hits = sum(1.0 for c in q_colours if c in tokset) * attr_mult
    material_hits = sum(1.0 for mtl in q_materials if mtl in tokset) * attr_mult

    adj = bool(attr_words) and type_present and _adjacent(toks, attr_words, all_types)
    adj_bonus = 3.0 if adj else 0.0

    if attr_words:
        exact = adj  # colour/material question: the colour must hug the type word
    else:
        exact = type_present and type_occ >= 2  # type-only: salient, repeated mention

    return type_hits + colour_hits + material_hits + adj_bonus, type_present, exact


def attribute_rerank(question, scenes, pool=None, max_scenes=6):
    """Re-rank `scenes` so the frame that actually shows the asked item wins, pull in
    strong attribute matches the retriever missed, and — when the asked item is
    clearly present — FOCUS the answer context on just the matching frames.

    Why focusing matters: re-ordering alone did not fix the walk's wrong-item bugs.
    For "what colour was the bag?" the white-backpack frame ranked first, but the
    gray-trash-bag frame stayed in the context, and the answer model anchored on the
    literal word "bag" and replied "gray". The distractor has to LEAVE the context,
    not just drop a rank. So when one or more frames match the question's type AND
    its colour/material (a genuine, specific hit), the returned context is restricted
    to those matching frames; everything else is dropped for THIS question only.

    Behaviour:
      - No distinguishing attribute in the question -> return scenes unchanged.
      - `pool` (full keyframe memory) given -> inject strong attribute matches the
        retriever ranked too low (the fuller 'ROBERT SAUER' poster OCR), so they can
        be read.
      - Strong matches exist -> return ONLY the matching frames (ranked), so the
        model can't read a conflicting item. Otherwise -> return the full set
        re-ranked by attribute boost (recall preserved; the grounding gate and
        honest-refusal default still decide the answer).
    """
    q_colours, q_materials, q_type_sets = _question_attributes(question)
    if not (q_colours or q_materials or q_type_sets):
        return scenes

    seen = {(s.get("t"), s.get("frame")) for s in scenes}

    # Pull EXACT matches the retriever missed: frames where the asked colour hugs
    # the asked type ('yellow poster' on the Robert-Sauer frame, ranked too low to
    # be retrieved) — or, for a type-only question, a strongly-repeated type mention.
    # Only exact pulls are injected, so background "yellow strip + billboard" frames
    # are never dragged in.
    if pool:
        pulled = []
        for m in pool:
            key = (m.get("t"), m.get("frame"))
            if key in seen:
                continue
            b, _tp, exact = _attribute_boost(m, q_colours, q_materials, q_type_sets)
            if exact:
                seen.add(key)
                pulled.append((b, m))
        pulled.sort(key=lambda x: -x[0])
        for _, m in pulled[:4]:
            scenes = scenes + [m]

    # Score every candidate; collect the EXACT matches (the asked item, unambiguous).
    scored = []
    matches = []
    for i, s in enumerate(scenes):
        base = s.get("_sem_score")
        base = float(base) if isinstance(base, (int, float)) else 0.0
        b, _tp, exact = _attribute_boost(s, q_colours, q_materials, q_type_sets)
        scored.append((base + b, -i, s))
        if exact:
            matches.append((base + b, -i, s))

    # Focus: when one or more frames are the asked item exactly, answer ONLY from
    # them so a conflicting item ('gray plastic bag' in a bin, the X-ray poster
    # when the yellow one was asked) cannot leak into the model's context.
    if matches:
        matches.sort(key=lambda x: (-x[0], -x[1]))
        focused = [s for _, _, s in matches]
        return focused[:max_scenes] if max_scenes else focused

    scored.sort(key=lambda x: (-x[0], -x[1]))
    out = [s for _, _, s in scored]
    return out[:max_scenes] if max_scenes else out


def resolve_item_term(question, scenes):
    """If the question names an object by a TYPE word but the focused frames describe
    it under a SYNONYM (the user asks about a 'bag', the caption says 'backpack'),
    return the question with that noun rewritten to the synonym actually seen — else
    the question unchanged.

    This is the last mile of attribute-aware retrieval: even after the right frame is
    the only one in context, its caption can ALSO contain the literal question word
    for a different object ('white backpack ... a gray plastic bag' in the trash bin),
    and the answer model anchors on the literal 'bag' -> 'gray'. Renaming the
    question's noun to the salient synonym ('what colour was the backpack') points the
    model at the item the user means. Only rewrites when exactly ONE synonym group is
    asked and the synonym is unambiguously the dominant subject of the scenes.
    """
    qtokens = re.findall(r"[a-z]+", (question or "").lower())
    qset = set(qtokens)
    _, _, q_type_sets = _question_attributes(question)
    if len(q_type_sets) != 1:
        return question
    syns = q_type_sets[0]
    asked = [w for w in qtokens if w in syns]
    if not asked:
        return question
    asked_word = asked[0]

    # Count how often each synonym appears across the focused scenes' captions.
    counts = {}
    for s in scenes:
        toks = re.findall(r"[a-z]+",
                          ((s.get("caption", "") or s.get("description", "")) + " "
                           + (s.get("_ocr_txt", "") or "")).lower())
        for t in toks:
            if t in syns:
                counts[t] = counts.get(t, 0) + 1
    if not counts:
        return question

    dominant = max(counts, key=counts.get)
    asked_count = counts.get(asked_word, 0)
    dom_count = counts.get(dominant, 0)
    # Rewrite ONLY when the user's own word is essentially absent from the scenes
    # (a stray distractor mention, count <= 1) while a synonym dominates them — that
    # is the bag-vs-backpack case. When the asked word itself appears repeatedly
    # (it's a genuine reference to the item, e.g. the yellow POSTER described as a
    # poster several times), keep it: a sideways swap among equally-valid signage
    # words (poster->sign) would only risk pointing the model at the wrong surface.
    if dominant != asked_word and asked_count <= 1 and dom_count >= 2 \
            and dom_count > asked_count:
        return re.sub(r"\b%s\b" % re.escape(asked_word), dominant, question,
                      flags=re.IGNORECASE)
    return question


def _merge_scenes(*lists, cap=7):
    """Union of several ranked scene lists, deduped by (time, frame), preserving the
    order given (semantic first, then lexical). Maximizes recall: the answer model and
    grounding gate decide which retrieved scene actually answers."""
    seen, out = set(), []
    for L in lists:
        for s in L or []:
            key = (s.get("t"), s.get("frame"))
            if key in seen:
                continue
            seen.add(key)
            out.append(s)
            if len(out) >= cap:
                return out
    return out


def _sem_retrieve(question, kf, kf_path, k):
    """Semantic top-k frames, or None if the embedding index is unavailable (caller
    then falls back to IDF). A low-similarity ceiling means a question about something
    never seen still surfaces weak frames — the answer prompt + grounding gate, not
    retrieval emptiness, produce the honest refusal in that case."""
    if _semantic is None or not kf or not kf_path:
        return None
    try:
        return _semantic.retrieve(question, kf, kf_path, k=k)
    except Exception:
        return None


def retrieve(question, memory, k=4, idf=None, ocr_boost=1.0):
    """Return up to k scenes ranked by IDF-weighted overlap over caption + OCR.

    ocr_boost multiplies overlap that comes only from read text (OCR tokens not
    already in the caption) — reading questions pass 2.0 to favor the layer that
    holds their answer. Scenes with zero discriminating overlap are NOT returned
    (no scenes[0] fallback — that empty result is the honest-refusal source).

    Tie-breaker: when many scenes match a query token equally (e.g. a long "train
    station platform" caption run all hit "station"), the answer for an identity/
    place question lives in the scene that actually READ the signage. A small bonus
    (capped well below one IDF unit, scaled by ocr_boost so it's active for reading
    questions) nudges OCR-rich scenes ahead without overriding a genuine match.
    """
    qwords = {w for w in _tokens(question)
              if (len(w) >= 3 or w.isdigit()) and w not in STOP}
    idf = idf if idf is not None else _idf(memory)
    scored = []
    for m in memory:
        # Fall back to description when caption is absent (self-test items).
        cap_words = set(_tokens(m.get("caption", "") or m.get("description", "")))
        ocr_words = set(_tokens(m.get("_ocr_txt", "")))
        score = (sum(idf.get(w, 0.0) for w in (qwords & cap_words))
                 + ocr_boost * sum(idf.get(w, 0.0)
                                   for w in (qwords & (ocr_words - cap_words))))
        if score > 0:
            # Tiny OCR-richness tie-breaker: 0..0.25 * ocr_boost, saturating at
            # ~10 read tokens. Far below idf of any real word, so it only orders
            # otherwise-equal scenes toward the ones that read the most text.
            ocr_rich = min(len(ocr_words), 10) / 40.0 * ocr_boost
            scored.append((score, ocr_rich, m))
    scored.sort(key=lambda x: (-x[0], -x[1]))
    return [m for _, _, m in scored[:k]]


# --------------------------------------------------------------------------- #
# Question classification (first match wins, priority order matters).
# --------------------------------------------------------------------------- #
TEMPORAL_RE = re.compile(
    r"\b(how long|how much time|duration|longer|before|after|first|then|next|"
    r"order|sequence|while|during|earlier|later|at the (start|beginning|end)|"
    r"when did)\b")

COUNTING_RE = re.compile(
    r"\b(how many|how much|number of|count|are there|were there|several|few)\b")

# A reading question asks what something SAYS, or its answer lives in read text
# (identity/place/translation/menus/screens). Kept broad on purpose.
READING_RE = re.compile(
    r"\b(say|says|said|read|reads|written|write|writing|label|brand|word|number|"
    r"text|sign|poster|note|title|caption|print|translate|translated|translation|"
    r"station|located|location|where am i|whose|name|called|molecule|menu|screen|"
    r"display|displayed|show(s|ing)? on)\b")

# Tight pattern for pure verbatim-quote questions (caption withheld, no interpret).
VERBATIM_RE = re.compile(
    r"\b(say|says|said|read|reads|written|verbatim|exact(ly)? (text|words)|"
    r"word for word)\b")

# A reading SURFACE — when one of these is the subject, "say"/"said" means the
# words printed on it (OCR), NOT something spoken aloud. Used to keep audio and
# reading apart ("what did the sign say" = reading, not audio).
READING_SURFACE_RE = re.compile(
    r"\b(sign|signs|poster|posters|screen|label|document|note|form|billboard|"
    r"plaque|menu|display|monitor|page|book|paper|card|board|chat|prompt|text)\b")

# Audio / speech channel. TRACE's voice is a SEPARATE transcript; these questions
# must never be answered from the visual layers (the -12 failure: "what words
# were said" answered with object labels). Speech verbs + audio events + the
# "words ... said/spoken" shape.
AUDIO_RE = re.compile(
    r"\b(spoke|speak\w*|spoken|talk\w*|voice|heard|hearing|audio|"
    r"sound\w*|noise|cry\w*|yell\w*|scream\w*|music|song|melody|whisper\w*|"
    r"conversation|announce\w*|aloud|out loud)\b"
    r"|\bwords?\b[^?.!]{0,20}\b(said|spoken)\b"
    r"|\b(said|spoken)\b[^?.!]{0,20}\b(aloud|out loud|during|in the)\b")

# Egocentric RELATIVE-direction questions. The keyframe memory holds what was
# seen/read but NO heading or pose, so it cannot say what was left/right/ahead of
# the wearer. Requires relative phrasing so a plain "where is the WC" (answerable
# from a sign) is NOT caught — only "which side / compared to me / to my left".
SPATIAL_RE = re.compile(
    r"\bwhich side\b|\bleft or right\b|\bto (the|my) (left|right)\b|"
    r"\b(left|right|front|behind|ahead|side)\b[^?.!]{0,15}\b(of|from)\b[^?.!]{0,8}"
    r"\b(me|my|where i was|my position)\b|"
    r"\b(compared to|relative to|next to|in front of|behind)\b[^?.!]{0,15}"
    r"\b(me|my|where i was|my position|my seat|my spot)\b|"
    r"\bwhich direction\b|\bwhat direction\b")


def is_reading_question(q):
    return bool(READING_RE.search(q.lower()))


def is_audio_question(q):
    """Spoken/heard audio — but not when a reading surface owns the 'say'."""
    ql = q.lower()
    return bool(AUDIO_RE.search(ql)) and not READING_SURFACE_RE.search(ql)


def is_spatial_question(q):
    return bool(SPATIAL_RE.search(q.lower()))


# Screen / UI questions: mentions Claude-app UI elements specifically.
# Uses a stricter pattern than just "laptop" to avoid intercepting temporal
# questions like "how long on the laptop" — those go through temporal first.
# Bare "laptop" / "screen" alone are NOT sufficient; at least one of the
# UI-specific terms below must appear (chat, claude, notification, badge, etc.)
# OR both "screen" and a content/state verb ("show", "display", "what was on").
SCREEN_SPECIALIST_RE = re.compile(
    r"\b(claude|chat|notification|badge|input box|prompt box|desktop|"
    r"window title|chat title|session card|needs input|asking for input|"
    r"unsent|not sent|typed but|written but|claude\.ai)\b"
    r"|monitor\b.*\b(show|display|said|read|written)\b"
    r"|\b(show|display|said|read|written)\b.*\bmonitor\b"
    r"|\bscreen\b[^.?!]{0,40}\b(show|display|said|read|written|on it|on the)\b"
    r"|\b(what|which|colour|color)\b[^.?!]{0,30}\b(screen|laptop|monitor)\b",
    re.IGNORECASE,
)


def is_screen_question(q):
    """True when a question is specifically about the Claude-app laptop screen UI."""
    return bool(SCREEN_SPECIALIST_RE.search(q))


def classify_question(q):
    """Return 'audio' | 'spatial' | 'temporal' | 'counting' | 'screen' | 'reading' | 'general'.

    Audio and spatial are checked FIRST: both name channels TRACE's visual memory
    cannot answer from, so they must short-circuit before a stray word ("said",
    "side") routes them into reading/counting where the model would confabulate.
    Temporal and counting are checked before screen so "how long on the laptop"
    routes to temporal rather than the screen specialist. Screen is checked after
    temporal/counting but before generic reading so the screen_reader specialist
    handles Claude-UI questions rather than the generic OCR/caption path.
    """
    ql = q.lower()
    if is_audio_question(q):
        return "audio"
    if is_spatial_question(q):
        return "spatial"
    if TEMPORAL_RE.search(ql):
        return "temporal"
    if COUNTING_RE.search(ql):
        return "counting"
    if is_screen_question(q):
        return "screen"
    if is_reading_question(q):
        return "reading"
    return "general"


# --------------------------------------------------------------------------- #
# Shared HTTP helper.
# --------------------------------------------------------------------------- #
def _ollama(prompt, model, host, timeout):
    """POST one prompt to ollama /api/generate (temperature 0, no stream) and
    return the response text. Raises on failure — callers handle the fallback."""
    req = urllib.request.Request(
        host.rstrip("/") + "/api/generate",
        data=json.dumps({"model": model, "prompt": prompt, "stream": False,
                         "options": {"temperature": 0}}).encode(),
        headers={"Content-Type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8", "replace")).get("response", "").strip()


# --------------------------------------------------------------------------- #
# Prompt templates.
# --------------------------------------------------------------------------- #
READING_PROMPT = (
    "You are the memory of someone's day, recalled from short scene notes. Each scene\n"
    "lists TEXT READ (exact words/numbers seen on signs, screens, posters, labels) and\n"
    "SEEN (what the scene looked like). Use the TEXT READ as ground truth. You may apply\n"
    "general world knowledge to turn fragments into a concrete answer — for example, a\n"
    "name plus life-dates next to an X-ray tube identifies the scientist; a German phrase\n"
    "can be translated; a station sign names the place. State the concrete answer in 1-2\n"
    "sentences, then cite the time(s) the supporting text was read, e.g. \"(read at 2.5s)\".\n"
    "RULES — follow exactly:\n"
    "- Answer ONLY the specific thing asked. Do NOT add biography, history, affiliations,\n"
    "  or any extra fact beyond what the question asks — even if you happen to know it.\n"
    "- Every name, number, year, and color in your answer MUST literally appear in the\n"
    "  TEXT READ or SEEN below. If it isn't there, you may not write it.\n"
    "- If the question is about a SPECIFIC item (a particular poster, the blue one, the\n"
    "  molecule, that sign), use ONLY a scene whose TEXT READ/SEEN is about THAT item.\n"
    "  NEVER carry a name or detail read on one item onto a different item. If no scene\n"
    "  clearly read that specific item, say you didn't read that one — do not substitute\n"
    "  a name from another poster.\n"
    "- If the read text is too garbled, missing, or unrelated to answer, say:\n"
    "  \"I don't have that in my memory — I didn't read enough to be sure.\" Do not guess.\n"
    "\n"
    "Scenes:\n%s\n\nQuestion: %s\nAnswer:")

VERBATIM_PROMPT = (
    "You are the memory of someone's day. Below is the EXACT text that was read off\n"
    "things in the relevant scenes — nothing else. Answer using ONLY this read text:\n"
    "quote the relevant words verbatim and give the time they were read. Do not translate,\n"
    "interpret, or guess. If none of it answers the question, say you couldn't read it.\n"
    "\n"
    "Text read in the scenes:\n%s\n\nQuestion: %s\nAnswer:")

GENERAL_PROMPT = (
    "You are the memory of someone's home. Using ONLY these remembered scenes, answer in "
    "1-2 plain sentences; mention the time in seconds if relevant. If the scenes don't "
    "show the thing asked about, say you didn't see it. Never invent.\n\n"
    "Remembered scenes:\n%s\n\nQuestion: %s\nAnswer:")

TEMPORAL_PROMPT = (
    "You are the memory of someone's day. Below is how their time broke down: how long\n"
    "they spent on each subject, and the order of episodes. Answer the question in 1-2\n"
    "plain sentences using ONLY these durations and this order. For \"how long\" give the\n"
    "seconds; for \"which was longer\" compare the seconds; for order/sequence questions\n"
    "give the chronological order. If the subject asked about is not listed, say you don't\n"
    "have it. Never invent durations.\n"
    "\n"
    "%s\n\nQuestion: %s\nAnswer:")


# --------------------------------------------------------------------------- #
# Per-layer answerers.
# --------------------------------------------------------------------------- #
def answer_reading(question, scenes, model, host, timeout):
    """Reading / identity / place / translation: fuse OCR (ground truth) with the
    caption and gemma's world knowledge to produce a concrete cited answer.

    Pure verbatim-quote questions withhold the caption so a recognised-by-sight
    detail cannot leak in as if it were read.
    """
    verbatim = bool(VERBATIM_RE.search(question.lower()))
    if verbatim:
        ctx = "\n".join(
            "[t=%ss] TEXT READ: %s" % (s.get("t"), s.get("_ocr_txt") or "(none)")
            for s in scenes)
        prompt = VERBATIM_PROMPT % (ctx, question)
    else:
        ctx = "\n".join(
            "[t=%ss] TEXT READ: %s\n         SEEN: %s"
            % (s.get("t"), s.get("_ocr_txt") or "(none)", s.get("caption", ""))
            for s in scenes)
        prompt = READING_PROMPT % (ctx, question)
    try:
        draft = _ollama(prompt, model, host, timeout)
    except Exception:
        s = scenes[0]
        return "Around %ss I read: %s" % (s.get("t"), s.get("_ocr_txt") or "(nothing readable)")
    if not verify_grounded(question, ctx, draft, model, host, timeout):
        return GROUNDED_REFUSAL
    return draft


def _fmt_scene(s):
    line = "- (at %ss) %s" % (s.get("t"), s.get("caption", s.get("description", "")))
    ocr = s.get("_ocr_txt")
    if ocr:
        line += "\n    (text read here: %s)" % ocr
    return line


# Honest refusal for egocentric direction: the keyframe memory has no pose/heading.
SPATIAL_REFUSAL = (
    "I remember what I saw and read, but not directions relative to where you were "
    "standing — I don't track left/right or which side of you things were on.")

GROUNDED_REFUSAL = "I don't have that in my memory — I didn't read enough to be sure."

# Phrases that already signal an honest don't-know; the grounding gate skips these
# (re-checking a refusal can only wrongly "support" or wrongly flag it).
REFUSAL_MARKERS = (
    "i don't have that", "i didn't read", "didn't see", "don't have it", "couldn't read",
    "i don't know", "no clear speech", "i didn't capture", "i don't track", "i had no",
    "didn't read enough", "i had trouble reaching")


def _is_refusal(text):
    t = (text or "").lower()
    return any(m in t for m in REFUSAL_MARKERS)


# Second pass: the failure left after the leash is "describes a retrieved-but-wrong
# item as if it answered" (asked the OTHER blue poster -> describes the X-ray one;
# asked the molecule poster's author -> names the yellow poster's). A focused binary
# fact-check catches that, where the buried rule in the answer prompt did not.
GATE_PROMPT = (
    "You are a strict fact-checker for a memory system. Below is the TEXT it actually\n"
    "read and saw in the relevant scenes, the QUESTION, and its DRAFT ANSWER.\n"
    "Reply UNSUPPORTED if ANY of these is true:\n"
    "- the draft states a person, brand, place name, or number that does NOT appear in\n"
    "  the TEXT;\n"
    "- the question asks about ONE specific item (a particular / 'other' / named poster,\n"
    "  sign, molecule, or object) but the TEXT does not actually contain THAT item — then\n"
    "  any answer naming or describing it is a guess. Example: asked who is on the\n"
    "  molecule poster, but the TEXT only shows a name on a station sign -> UNSUPPORTED;\n"
    "- the draft attributes a name/detail to the asked item that the TEXT ties to a\n"
    "  DIFFERENT item, or describes a different item than the one asked;\n"
    "- the draft adds biography, history, or facts not present in the TEXT.\n"
    "Otherwise reply SUPPORTED. Translating words that ARE in the TEXT (e.g. German) into\n"
    "English is allowed and SUPPORTED. A draft that already says it doesn't know is\n"
    "SUPPORTED. Describing colours/shapes actually noted in the SEEN text is SUPPORTED.\n"
    "Reply with exactly ONE word: SUPPORTED or UNSUPPORTED.\n\n"
    "TEXT:\n%s\n\nQUESTION: %s\nDRAFT ANSWER: %s\n\nVerdict:")


def verify_grounded(question, context, draft, model, host, timeout):
    """True if the draft is grounded in context. Conservative by design: an already
    honest refusal, any HTTP error, or an ambiguous reply all return True, so the gate
    only ever DEMOTES a confident answer it is sure is unsupported — it never invents."""
    if not draft or _is_refusal(draft):
        return True
    try:
        v = _ollama(GATE_PROMPT % (context, question, draft), model, host, timeout)
    except Exception:
        return True
    return "unsupported" not in v.strip().lower()[:40]


def answer_audio_events(question, events_log, model, host, timeout):
    """Non-speech sound-event question (crying/yelling/alarm/noise) -> answered
    from the CACHED capture-time audio-event log (audio_events.json) ONLY.

    The raw wave is never opened here: build_audio_events.py already turned it
    into this small text log at capture. If the capture was near-silent
    (usable_sound=false) we honestly report no detectable sound rather than
    invent a cry — that refusal is the channel working as designed.
    """
    if not events_log:
        return ("I didn't analyse an audio channel for this walk, so I can't tell "
                "you whether there were sounds like crying or yelling.")

    overall_db = events_log.get("overall_db")
    usable = events_log.get("usable_sound")
    events = events_log.get("events") or []
    db_txt = ("%.1f dB" % overall_db) if isinstance(overall_db, (int, float)) else "unknown level"

    if not usable:
        return ("No crying, yelling, or other distinct sound was detected — the "
                "captured audio was near-silent throughout this walk (overall "
                "%s, below the level at which any sound event registers). I'm "
                "answering from the sound analysis logged at capture, not by "
                "re-listening, so I won't invent a sound that wasn't there." % db_txt)

    if not events:
        return ("I analysed the captured sound and found no distinct events like "
                "crying, yelling, alarms, or music (overall %s). Nothing rose "
                "above ambient." % db_txt)

    # Usable audio WITH logged events: let gemma reason over the event TEXT.
    ev_lines = "\n".join(
        "- %s from %.1fs to %.1fs (confidence %.0f%%) [%s]"
        % (e.get("label"), e.get("start", 0.0), e.get("end", 0.0),
           100 * float(e.get("confidence", 0.0)), e.get("evidence", ""))
        for e in events)
    prompt = (
        "You are the sound memory of someone's day. At capture time the raw audio "
        "was analysed (energy, pitch, spectral shape — no transcription) into the "
        "event list below. Overall level: %s. Answer the question in 1-2 plain "
        "sentences using ONLY these logged events; cite the times. If no listed "
        "event matches what is asked, say it wasn't detected. Never invent a "
        "sound that is not in the list.\n\n"
        "Detected sound events:\n%s\n\nQuestion: %s\nAnswer:"
        % (db_txt, ev_lines, question))
    try:
        return _ollama(prompt, model, host, timeout)
    except Exception:
        return "I had trouble reaching my sound memory just now."


def answer_audio(question, transcript, model, host, timeout):
    """Spoken-word / heard-sound question -> the voice transcript ONLY.

    When the capture recorded no usable speech, this returns an honest 'I didn't
    hear it' instead of letting a visual layer confabulate words. When speech IS
    present, it answers from the transcript text (never from captions/OCR)."""
    if not transcript:
        return ("I didn't capture an audio channel for this walk, so I can't tell you "
                "what was said or heard.")
    if not transcript.get("usable_speech"):
        verdict = (transcript.get("verdict") or "no clear speech was detected").strip().rstrip(".")
        return ("I didn't capture clear speech — %s. So I can't tell you what was said "
                "or heard." % verdict)
    text = (transcript.get("text") or transcript.get("transcript")
            or transcript.get("raw_whisper") or "").strip()
    if not text:
        return "I had an audio channel but no transcribed words, so I can't tell you what was said."
    prompt = (
        "Below is the transcript of what was actually spoken/heard during a recording. "
        "Answer the question in 1-2 plain sentences using ONLY this transcript; quote the "
        "relevant words. If the transcript does not contain the answer, say you didn't hear "
        "it. Never invent speech.\n\nTranscript:\n%s\n\nQuestion: %s\nAnswer:" % (text, question))
    try:
        return _ollama(prompt, model, host, timeout)
    except Exception:
        return "I had trouble reaching my audio memory just now."


def answer_general(question, scenes, model, host, timeout):
    """General non-reading question: answer from caption (with OCR appended)."""
    ctx = "\n".join(_fmt_scene(s) for s in scenes)
    prompt = GENERAL_PROMPT % (ctx, question)
    try:
        draft = _ollama(prompt, model, host, timeout)
    except Exception:
        s = scenes[0]
        return "Around %ss: %s" % (s.get("t"), s.get("description"))
    if not verify_grounded(question, ctx, draft, model, host, timeout):
        return GROUNDED_REFUSAL
    return draft


def ask_world(question, objects, model, host, timeout=60):
    """Answer from the ONE deduplicated room memory (the product has no photos to
    show — it kept only this). No per-frame retrieval, no images returned."""
    inv = "\n".join("- %s (count: %s) — %s%s"
                    % (o.get("name"), o.get("count"),
                       o.get("attributes") or "",
                       ("; " + o["where"]) if o.get("where") else "")
                    for o in objects)
    prompt = (
        "This is your complete memory of one room — the distinct objects in it, how many "
        "of each, and their details. It is ALL you know; there are no photos. Answer the "
        "question in 1-2 plain sentences using ONLY this memory. For 'how many' questions "
        "give the count from the memory (do not add things up again). If it isn't in the "
        "memory, say you don't have it. Never invent.\n\n"
        "Memory of the room:\n%s\n\nQuestion: %s\nAnswer:" % (inv, question))
    try:
        return _ollama(prompt, model, host, timeout)
    except Exception:
        return "I couldn't reach my memory just now."


def answer_counting(question, world_objects, model, host, timeout):
    """Counting -> the deduplicated world inventory (already counted, no re-add)."""
    return ask_world(question, world_objects, model, host, timeout)


def answer_temporal(question, kf_path, scenes, model, host, timeout, k=4):
    """Temporal -> durations from the episode index. Returns (answer, proof_scenes).

    Degrades to a general best-effort over retrieved scenes if the index module
    is missing/broken so a temporal question still answers and never crashes.
    """
    if _temporal is None or kf_path is None:
        return (answer_general(question, scenes, model, host, timeout), scenes)

    idx = _temporal.get_durations(kf_path)
    episodes = idx.get("episodes", [])
    by_label = idx.get("by_label", {})
    total = idx.get("total_s", 0.0)
    if not episodes:
        return ("I don't have that in my memory — I didn't track the timing.", [])

    lines = ["Total time: %.1fs" % total, "Time spent per subject:"]
    for label, dur in sorted(by_label.items(), key=lambda x: -x[1]):
        lines.append("- %s: %.1fs" % (label, dur))
    lines.append("Episodes in order:")
    for ep in episodes:
        lines.append("- %s from %.1fs to %.1fs (%.1fs)"
                     % (ep["label"], ep["start"], ep["end"], ep["duration"]))
    ctx = "\n".join(lines)
    prompt = TEMPORAL_PROMPT % (ctx, question)

    # Proof frames: episodes the question names, else the longest episodes.
    ql = question.lower()
    named = [ep for ep in episodes if ep["label"] in ql]
    chosen = named[:k] if named else sorted(episodes, key=lambda e: -e["duration"])[:k]
    proof = [{"t": ep.get("t"),
              "frame": ep["frames"][0] if ep.get("frames") else None}
             for ep in chosen]

    try:
        ans = _ollama(prompt, model, host, timeout)
    except Exception:
        ans = ctx
    return (ans, proof)


# --------------------------------------------------------------------------- #
# compose: thin back-compat dispatcher (reading vs general).
# --------------------------------------------------------------------------- #
def compose(question, scenes, model, host, timeout=60):
    """Back-compat wrapper: dispatch a retrieved-scene answer to reading/general."""
    if is_reading_question(question):
        return answer_reading(question, scenes, model, host, timeout)
    return answer_general(question, scenes, model, host, timeout)


# --------------------------------------------------------------------------- #
# Top-level routing.
# --------------------------------------------------------------------------- #
def ask(question, memory_path, model="gemma3:12b-it-qat",
        host="http://127.0.0.1:11434", timeout=60, k=4):
    mems = _resolve_memories(memory_path)
    kf, world, kf_path = mems["kf"], mems["world"], mems["kf_path"]

    if not kf and not world:
        return {"answer": "I haven't built a memory of your home yet.", "scenes": []}

    kind = classify_question(question)

    # 0a) audio/speech -> the voice transcript ONLY (refuse if no usable speech).
    #     Never let the visual layers answer "what was said" (the -12 failure).
    #     For sound-event questions (crying/yelling/noise) also consult the
    #     audio_events specialist so the detector's verdict supplements the
    #     transcript refusal, rather than leaving the user with only "no speech".
    if kind == "audio":
        transcript = load_transcript(memory_path)
        # Check whether the question is about non-speech sound events.
        _audio_event_words = {"cry", "crying", "cried", "yell", "yelling",
                              "scream", "screaming", "sound", "noise", "loud",
                              "hear", "heard", "music", "alarm", "siren"}
        _ql_words = set(question.lower().split())
        _wants_events = bool(_ql_words & _audio_event_words)
        if _wants_events:
            # Sound-event questions are answered from the CACHED capture-time log
            # (audio_events.json), built once by scripts/build_audio_events.py.
            # We do NOT re-open audio.wav at query time (the previous breach:
            # routing through _audio_events.answer() which called sf.read() on the
            # raw wav per question). Text in, text out — no raw media at query.
            events_log = load_audio_events(memory_path)
            if events_log is not None:
                return {"answer": answer_audio_events(
                    question, events_log, model, host, timeout), "scenes": []}
            # No cached log present -> fall through to the transcript-based answer
            # (still text-only). The raw wav is never touched here.
        return {"answer": answer_audio(question, transcript, model, host, timeout),
                "scenes": []}

    # 0b) egocentric direction -> refuse: no pose/heading is stored, so any
    #     left/right/which-side answer would be a guess.
    if kind == "spatial":
        return {"answer": SPATIAL_REFUSAL, "scenes": []}

    # 0c) screen / Claude-UI questions -> screen_reader specialist.
    if kind == "screen":
        if _screen_reader is not None and kf is not None:
            try:
                return {"answer": _screen_reader.answer(
                    question, kf, kf_path, model, host, timeout), "scenes": []}
            except Exception:
                pass  # fall through to generic reading path
        # Fallback: treat as a reading question if specialist unavailable.
        kind = "reading"

    # 1) counting -> counting_specialist (fallback: world inventory)
    if kind == "counting":
        if _counting_specialist is not None and kf:
            try:
                return {"answer": _counting_specialist.answer(
                    question, kf, world, model, host, timeout), "scenes": []}
            except Exception:
                pass  # fall through to ask_world
        if world:
            return {"answer": answer_counting(question, world, model, host, timeout),
                    "scenes": []}

    # 2) temporal -> temporal_specialist (fallback: old duration-index path)
    if kind == "temporal":
        if _temporal_specialist is not None and kf:
            try:
                return {"answer": _temporal_specialist.answer(
                    question, kf, kf_path, model, host, timeout), "scenes": []}
            except Exception:
                pass  # fall through to old path
        if kf_path:
            scenes = retrieve(question, kf, k=k, idf=_idf(kf)) if kf else []
            ans, proof = answer_temporal(question, kf_path, scenes, model, host, timeout, k=k)
            return {"answer": ans, "scenes": proof}

    # 3) reading/identity/place AND general -> keyframe retrieval (OCR+caption)
    if not kf:
        # Only a world file present + a non-counting question we can't ground in
        # frames: best-effort off the lossy world layer, no proof photos.
        return {"answer": ask_world(question, world, model, host, timeout) if world
                else "I don't have that in my memory of your home — I didn't see it.",
                "scenes": []}

    reading = (kind == "reading")
    # Semantic retrieval (finds molecule<->Molekül<->molecular across language/word-form);
    # IDF fallback only if the embedder is unavailable. Semantic-primary beats a
    # semantic+IDF union here: extra lexical frames feed the model wrong items to
    # describe (the "other" poster, a stray bag), costing more precision than the recall
    # is worth. k=6 keeps recall high enough to surface co-located posters (Sauer).
    scenes = _sem_retrieve(question, kf, kf_path, k=6)
    if scenes is None:
        scenes = retrieve(question, kf, k=k, idf=_idf(kf), ocr_boost=2.0 if reading else 1.0)
    if not scenes:
        return {"answer": "I don't have that in my memory of your home — I didn't see it.",
                "scenes": []}
    # Attribute-aware re-rank: when the question names a colour/material/type, put
    # the frame that actually shows THAT item first (and pull in strong attribute
    # matches the retriever ranked too low — e.g. the fuller 'ROBERT SAUER' poster
    # OCR), so the answer model reads the right scene (white backpack, not a stray
    # gray bin-bag). Only reorders/augments — never drops a retrieved frame.
    scenes = attribute_rerank(question, scenes, pool=kf)
    # Point the answer model at the asked item even when the focused frame's caption
    # also names a different object by the literal question word (bag -> backpack),
    # so it reads the colour/detail of the right thing.
    aq = resolve_item_term(question, scenes)
    if reading:
        answer = answer_reading(aq, scenes, model, host, timeout)
    else:
        answer = answer_general(aq, scenes, model, host, timeout)
    return {"answer": answer, "scenes": scenes}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("question", nargs="*")
    ap.add_argument("--memory", default="data/walks/home_capture_20260613/memory/memory_full.json")
    ap.add_argument("--model", default="gemma3:12b-it-qat")
    ap.add_argument("--self-test", action="store_true")
    args = ap.parse_args()
    if args.self_test:
        mem = [{"t": 5, "frame": "a.jpg", "description": "a black table fan on the windowsill"},
               {"t": 9, "frame": "b.jpg", "description": "a bed with a laptop on a tray"}]
        load_memory_records(mem)
        top = retrieve("where is my fan", mem)
        assert top and "fan" in top[0]["description"], top
        print("SELF-TEST PASS"); return 0
    q = " ".join(args.question)
    res = ask(q, args.memory, args.model)
    print("Q:", q)
    print("A:", res["answer"])
    for s in res["scenes"]:
        print("   proof: %ss  %s" % (s.get("t"), s.get("frame")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
