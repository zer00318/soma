# Default to COMMIT mode (the fix). Set ASSEMBLER_COMMIT=0 to restore the old refuse-default
# leash prompt for an A/B (the structural gate is the safety net either way).
ASSEMBLER_COMMIT = os.environ.get("ASSEMBLER_COMMIT", "1") != "0"


def think_and_answer(question, dossier, model, host, timeout):
    """Prompt gemma to THINK over the whole dossier and answer on the provenance leash.

    Returns the model's text. The reasoning preamble (if any) is stripped to a clean
    answer line for the caller. On any HTTP failure returns an honest reach-failure note.
    """
    base_prompt = COMMIT_ASSEMBLER_PROMPT if ASSEMBLER_COMMIT else ASSEMBLER_PROMPT
    prompt = base_prompt % (dossier, question)
    try:
        raw = _ollama(prompt, model, host, timeout)
    except Exception:
        return "I had trouble reaching my memory just now."
    return _clean_assembler_answer(raw)


def _clean_assembler_answer(raw):
    """Trim a chatty 'reasoning then answer' reply down to the answer.

    gemma sometimes prefixes its reasoning. If it emits an explicit 'Answer:' (or
    similar) marker, keep what follows; otherwise return the text as-is (trimmed).
    Never fabricates — only slices the model's own words."""
    if not raw:
        return raw
    text = raw.strip()
    # Find the LAST answer-marker (gemma reasons, then states the answer) and keep
    # what follows. Case-insensitive over the markers; the slice is the model's own
    # words, never fabricated. A bare "Answer:" mid-sentence is ignored (must follow
    # a newline) so we don't chop a legitimate sentence.
    low = text.lower()
    best = -1
    best_end = 0
    for marker in ("\nanswer:", "\nfinal answer:", "\nmy answer:", "\nconcrete answer:"):
        idx = low.rfind(marker)
        if idx > best:
            best = idx
            best_end = idx + len(marker)
    if best != -1:
        tail = text[best_end:].strip()
        if tail:
            return tail
    return text


# ── STRUCTURAL grounding gate (deterministic, CPU-only — NO LLM) ─────────────── #
# Replaces the gemma verify_grounded pass with STRUCTURE (provenance + binding),
# proven 2026-06-18: a 12B model won't obey an accreting refusal prompt (cold RAS
# went 15.8 -> 0.0 as the leash was tuned). Three layered, deterministic checks,
# each from a CPU-only module; order matters (cheapest/strongest refusal first):
#
#   (G1) BINDING AMBIGUITY  — entity_graph.binding_confidence. When the QUESTION
#        names a specific item/person/screen and SEVERAL distinct entities of that
#        type fit (two green shirts; laptop vs whiteboard logo; 4 people), REFUSE
#        even if the token is high-reliability OCR. This is the day Q13/Q18 fix:
#        the right token is present but bound to the WRONG entity. A single `self`
#        candidate ("I/my") always binds — self-questions are never refused here.
#
#   (G2) VERBATIM-VALUE GROUNDING — when the answer asserts a SPECIFIC value (a
#        clock time like 13:30, or a brand/proper-noun logo like "Turks & Caicos"),
#        that literal value must appear in the raw read text. The day Q17 clock
#        (13:30 in ZERO channels) and Q18 logo (Turks in ZERO OCR) are pure model
#        world-knowledge -> REFUSE. (score_claim mis-keys here: it scores `physics`
#        at conf 1.0 and never sees 13:30, which _toks strips — so we check the
#        literal value against raw text, NOT against the token-support table.)
#
#   (G3) PHANTOM-PRESENCE FLOOR — a caption-ONLY claim that ASSERTS THE PRESENCE
#        of a concrete thing (the walk's phantom "train") is below the reliability
#        floor -> REFUSE. Critically this is gated on DIRECTION: a low-confidence
#        ABSENCE/negation ("empty / no train / not crowded", walk Q12/Q20) and a
#        faint-but-real ATTRIBUTE (the washed-out-blue bag, walk Q18) are NOT
#        refused — the phantom and the honest faint read share the 0.40 band, so a
#        blanket scalar floor would over-refuse the gold-correct answers (G5/G6).
#
# Outcome: ("assert", draft) | ("refuse", GROUNDED_REFUSAL) |
#          ("ambiguous", AMBIGUOUS_REFUSAL). Degrades to ("assert", draft) whenever
# a module/dir is unavailable or the answer carries no concrete value — the gate
# only ever DEMOTES a claim it can structurally show is weak/mis-bound; it never
# invents. Flip ASSEMBLER_GROUNDING_GATE=False to bypass entirely for A/B.
ASSEMBLER_CONF_MIN = 0.6          # phantom-presence floor (caption-only 0.40 fails)
ASSEMBLER_GROUNDING_GATE = True   # run the structural gate; False bypasses it entirely

# (G4) general corpus-grounding floor — refuse a confident answer whose distinctive
# tokens are mostly absent from what was actually read.
# DISABLED 2026-06-19 — proven a NET REGRESSION offline against the cold clip's 25 drafts:
# it caught 0 fabrications the existing gate missed and killed 4 extra correct answers
# (RAS 57.1->40.0, halluc 21.4%->30%). Root reason, and the real lesson: the fabrications
# the gate still misses (Q17 "zip closed", Q20 "train", Q22 chat) have their tokens PRESENT
# in the corpus — they are MIS-BINDINGS, not missing tokens, so a corpus-presence floor
# cannot catch them. The fix is entity-centric binding (build_entity_capture.py), not a
# blunter gate. Kept disabled (not deleted) so this dead-end isn't re-tried.
ASSEMBLER_G4_FLOOR = False
G4_MIN_TOKENS = 4        # min distinctive (non-question, non-narration) tokens to judge
G4_MIN_UNGROUNDED = 3    # min absolute count of ungrounded distinctive tokens to refuse
G4_FRAC = 0.6            # min fraction of distinctive tokens ungrounded to refuse
# Generic framing/prose words gemma uses to wrap an answer — NOT asserted facts, so they
# don't count toward grounding either way (prevents prose from inflating ungrounded).
_G4_NARRATION = {
    "the", "this", "that", "these", "those", "there", "here", "with", "from", "into",
    "indicates", "indicate", "based", "observation", "observations", "observed",
    "multiple", "point", "points", "time", "times", "near", "located", "location",
    "present", "reported", "report", "described", "describe", "visible", "seen",
    "appears", "appear", "resembling", "associated", "featured", "feature", "depicts",
    "depict", "design", "reads", "read", "reading", "shows", "show", "showing", "various",
    "several", "including", "include", "approximately", "around", "across", "which",
    "where", "when", "what", "would", "could", "other", "another", "some", "they",
    "their", "your", "have", "been", "were", "also", "such", "than", "then", "about",
    "likely", "appeared", "and", "for", "was", "had", "its", "it's", "i've", "didn't",
}

AMBIGUOUS_REFUSAL = (
    "I can read the detail, but I can't tell which one you mean — it could belong to "
    "more than one thing I saw, so I won't guess which it was.")

# Does the question ask about ONE specific item/person/screen whose identity could be
# mis-attributed? (Triggers the binding-ambiguity refusal.) Pure regex, no state.
_SPECIFIC_ITEM_Q = re.compile(
    r"\b(who|whose|person|people|man|woman|guy|wear|wearing|worn|"
    r"logo|brand|sign|screen|laptop|tablet|monitor|whiteboard|board|tv|display|"
    r"poster|mural|shirt|outfit|jacket|bag|clock|time|said|says|read|reads|written|text)\b",
    re.I)
# A specific VALUE the answer might assert: a clock time, or a 4-digit year/number.
_VALUE_TIME_RE = re.compile(r"\b\d{1,2}:\d{2}\b")
# Capitalised tokens in the answer that look like a proper-noun / brand (logo class).
_VALUE_PROPER_RE = re.compile(r"\b([A-Z][a-zA-Z]{2,})\b")
_PROPER_STOP = {"The", "There", "This", "That", "These", "Those", "It", "He", "She",
                "They", "We", "You", "His", "Her", "Their", "Your", "Its", "And",
                "But", "For", "With", "From", "What", "When", "Where", "Who", "How",
                "Yes", "No", "An", "On", "In", "At", "Of", "To", "I"}
# Negation / absence cues — a LOW-confidence claim in this direction is the honest
# read of weak evidence (G5) and must survive the floor.
_ABSENCE_RE = re.compile(
    r"\b(no|not|n't|never|empty|none|nobody|nothing|without|wasn'?t|weren'?t|"
    r"isn'?t|aren'?t|didn'?t|absent|quiet|calm)\b", re.I)
# Concrete countable nouns whose ASSERTED PRESENCE on a caption-only channel is the
# phantom class (walk "train"). Deliberately NARROW: locomotion + animate + crowd —
# the things the 4-bit caption model conjures. Stationary scene furniture (bag,
# backpack, sign, screen, clock, door) is NOT here, because a faint-but-real ATTRIBUTE
# of such a thing (the washed-out-blue bag, walk Q18) must survive the floor (G6).
_PRESENCE_NOUN_RE = re.compile(
    r"\b(train|bus|car|truck|bike|bicycle|dog|cat|person|people|crowd|child|baby)\b",
    re.I)
# The floor only fires when the QUESTION is itself about presence/occurrence/state
# ("was there a train", "is it crowded", "did you see a dog") — not when the answer
# merely mentions such a noun in passing while describing something else (G5/G6).
_PRESENCE_Q = re.compile(
    r"\b(is|was|were|are|any|see|seen|there|crowd|crowded|busy|empty|present|"
    r"happen|occur)\b", re.I)
_DIRECT_SELF_WEARABLE_Q = re.compile(
    r"\b(?:do|did|was|am)\s+i\s+(?:wear|wearing|have)\b|"
    r"\bmy\s+(?:glasses|eyewear|spectacles|watch|wristwatch|bracelet|necklace|ring|hat|cap|earbuds)\b",
    re.I)
_WEARABLE_NOUN_RE = re.compile(
    r"\b(glasses|eyewear|spectacles|watch|wristwatch|bracelet|necklace|ring|hat|cap|earbuds)\b",
    re.I)
_STATE_QUESTION_RE = re.compile(
    r"\b(open|closed|zipped|unzipped|connected|disconnected|plugged|unplugged|"
    r"crowded|empty)\b", re.I)
_STATE_VALUE_RE = re.compile(
    r"\b(open|closed|zipped|unzipped|connected|disconnected|plugged|unplugged|"
    r"crowded|empty)\b", re.I)
_SCREEN_STATE_Q_RE = re.compile(
    r"\b(actively|active chat|asking for input|awaiting input|input notification|"
    r"notification colou?r|badge colou?r)\b", re.I)


def _screen_state_is_structured(question, mdir):
    """OCR text does not prove which UI element is active or what color it is."""
    path = os.path.join(mdir, "screen_memory.json")
    try:
        with open(path) as source:
            rows = json.load(source)
    except Exception:
        return False
    if not isinstance(rows, list):
        return False
    q = (question or "").lower()
    required = ({"notification_color", "badge_color"}
                if "color" in q or "colour" in q else
                {"active", "asking_for_input", "awaiting_input"})
    for row in rows:
        if not isinstance(row, dict):
            continue
        state = row.get("ui_state") if isinstance(row.get("ui_state"), dict) else row
        if any(state.get(field) not in (None, "", False) for field in required):
            return True
    return False


def _raw_text_corpus(mdir):
    """All read text (caption+ocr+screen+speech) lower-cased into one string, for
    VERBATIM value grounding. CPU-only; returns '' if nothing loads."""
    if _evidence is None:
        return ""
    try:
        obs = _evidence.load_observations(mdir)
    except Exception:
        return ""
    return " ".join((tx or "") for (_t, _ch, tx) in obs).lower()


def _state_bound_to_question_entity(question, state, mdir):
    """Require a state and the asked entity to co-occur in one observation."""
    if _evidence is None:
        return False
    qtokens = set(_dossier_tokens(question or "")) - set(_tokens(state or ""))
    qtokens -= {"open", "closed", "zipped", "unzipped", "connected", "disconnected",
                "plugged", "unplugged", "crowded", "empty", "zip", "zipper", "state"}
    alias_groups = (
        {"bag", "backpack", "rucksack", "knapsack"},
        {"phone", "iphone", "smartphone"},
        {"station", "platform"},
        {"lift", "elevator", "aufzug"},
    )
    targets = set(qtokens)
    for aliases in alias_groups:
        if qtokens & aliases:
            targets |= aliases
    if not targets:
        return False
    try:
        observations = _evidence.load_observations(mdir)
    except Exception:
        return False
    state_stem = (state or "").lower()[:max(4, len(state or "") - 2)]
    for _t, _channel, text in observations:
        low = (text or "").lower()
        if state_stem not in low:
            continue
        words = set(_tokens(low))
        if words & targets or any(target in low for target in targets if len(target) >= 4):
            return True
    return False


def structural_grounding(question, draft, memory_path):
    """Deterministic, LLM-free replacement for verify_grounded. Returns one of:
        ("assert", draft)                -- confident + unambiguously bound, return as-is
        ("refuse", GROUNDED_REFUSAL)     -- the asserted value/thing is unsupported
        ("ambiguous", AMBIGUOUS_REFUSAL) -- the detail is bound to the WRONG entity

    Conservative & non-regressing: an honest refusal is always asserted; any module
    or memory dir unavailable -> ASSERT (pass-through). The gate only DEMOTES a claim
    it can structurally show is weak/mis-bound, never invents an answer."""
    if not draft or _is_refusal(draft):
        return ("assert", draft)
    mdir = os.path.dirname(os.path.abspath(memory_path))
    graph = None

    # UI OCR proves visible words, not interaction state or color. These claims
    # require an explicit structured observation from the capture layer.
    if _SCREEN_STATE_Q_RE.search(question or "") and not _screen_state_is_structured(
            question, mdir):
        return ("refuse", GROUNDED_REFUSAL)

    # ── (G1) BINDING AMBIGUITY — refuse a specific-item question whose entity is
    # ambiguous, EVEN IF the token is high-reliability OCR (day Q13/Q18). A `self`
    # ("I/my") question binds to the unique wearer and is never refused here.
    if _entity_graph is not None and _SPECIFIC_ITEM_Q.search(question or ""):
        try:
            graph = _entity_graph.build_entities(mdir)
            bc = _entity_graph.binding_confidence(question, graph)
        except Exception:
            bc = None
        # REFUSE only on TRUE ambiguity: several distinct entities of the asked type
        # competed (the 1/n confidence band, conf>0). The "no entity matches" verdict
        # (conf==0) is NOT ambiguity — the graph simply has nothing to say, so we
        # DEFER to the value/floor checks rather than refuse a real faint read.
        if (bc is not None and not bc.get("answerable", True)
                and bc.get("confidence", 0.0) > 0.0):
            return ("ambiguous", AMBIGUOUS_REFUSAL)

    # A direct wearer-attribute answer may use only the persistent SELF entity.
    # Seeing glasses/watch on somebody else is not evidence that the wearer had it.
    if graph is not None and _DIRECT_SELF_WEARABLE_Q.search(question or "") \
            and not _ABSENCE_RE.search(draft or ""):
        asked = {x.lower() for x in _WEARABLE_NOUN_RE.findall(question or "")}
        selves = [e for e in graph.get("entities", [])
                  if e.get("type") == "self" and e.get("from_capture")]
        if asked and selves:
            self_text = " ".join(
                str(a.get("value") or "").lower()
                for e in selves for a in e.get("attributes", []))
            aliases = {"eyewear": {"eyewear", "glasses", "spectacles"},
                       "glasses": {"eyewear", "glasses", "spectacles"},
                       "spectacles": {"eyewear", "glasses", "spectacles"},
                       "watch": {"watch", "wristwatch", "smartwatch"},
                       "wristwatch": {"watch", "wristwatch", "smartwatch"}}
            supported = all(any(term in self_text for term in aliases.get(item, {item}))
                            for item in asked)
            if not supported:
                return ("refuse", GROUNDED_REFUSAL)

    # ── (G2) VERBATIM-VALUE GROUNDING — a clock time or brand/proper-noun the answer
    # asserts must appear LITERALLY in the read text (day Q17 13:30, Q18 Turks). _toks
    # strips numbers, so score_claim can't see these; we check raw text directly.
    corpus = _raw_text_corpus(mdir)
    asserts_grounded_value = False  # set when the answer carries a verbatim-read value
    if corpus:
        for tval in _VALUE_TIME_RE.findall(draft):
            if tval.lower() not in corpus:
                return ("refuse", GROUNDED_REFUSAL)
            asserts_grounded_value = True  # a real clock time, read verbatim -> trust it
        # Brand/logo class: only enforced when the QUESTION is about a logo/brand/sign,
        # so ordinary capitalised place/person names in prose aren't policed.
        if re.search(r"\b(logo|brand)\b", question or "", re.I):
            for prop in _VALUE_PROPER_RE.findall(draft):
                if prop in _PROPER_STOP:
                    continue
                if prop.lower() not in corpus:
                    return ("refuse", GROUNDED_REFUSAL)

        # Binary states are especially easy for a low-resolution attribute model
        # to guess. A state word asserted in the answer must itself occur in the
        # captured text corpus; object presence alone cannot license open/closed,
        # connected, or occupancy claims.
        if _STATE_QUESTION_RE.search(question or ""):
            for state in {value.lower() for value in _STATE_VALUE_RE.findall(draft or "")}:
                if state not in corpus or not _state_bound_to_question_entity(
                        question, state, mdir):
                    return ("refuse", GROUNDED_REFUSAL)

    # ── (G3) PHANTOM-PRESENCE FLOOR — a caption-only PRESENCE assertion (walk
    # "train") is below the floor. Gated on DIRECTION: negations/absence (Q12/Q20)
    # and faint colour ATTRIBUTES (Q18) are exempt (G5/G6).
    if (_evidence is not None
            and not asserts_grounded_value          # G2 already validated the real value
            and _PRESENCE_Q.search(question or "")   # the QUESTION asks about presence/state
            and _PRESENCE_NOUN_RE.search(draft or "")
            and not _ABSENCE_RE.search(draft or "")):
        try:
            sup = _evidence.build_support(_evidence.load_observations(mdir))
        except Exception:
            sup = None
        if sup is not None:
            # Score the concrete entity being asserted, not the whole sentence.
            # Whole-sentence scoring can select an unrelated well-supported token
            # and accidentally license a caption-only phantom.
            asserted = {noun.lower() for noun in _PRESENCE_NOUN_RE.findall(draft or "")}
            if any(_evidence.score_claim(noun, sup).get("confidence", 0.0)
                   < ASSEMBLER_CONF_MIN for noun in asserted):
                return ("refuse", GROUNDED_REFUSAL)

    # ── (G4) CORPUS-GROUNDING FLOOR — GENERAL, not per-clip. A confident answer whose
    # DISTINCTIVE content tokens are largely ABSENT from the read-text corpus is
    # confabulated. This generalizes G2/G3 without hand-picked noun lists: it compares
    # what the draft ASSERTS against what was actually READ (caption+ocr+screen+speech).
    # Stem-matched so paraphrase/inflection/full-name expansion of a PRESENT entity
    # passes; fires only when MANY distinctive tokens are ungrounded (fabrication, not
    # one synonym). Kills cold Q17 "zip=closed", Q20 phantom "train", Q9 "starry night"
    # without knowing those nouns in advance. Exempt: question tokens (not asserted),
    # generic narration verbs, colour/state words the attribute path owns, and any
    # answer that already grounded a verbatim value (G2). Founder's rule: an honest
    # refusal is a WIN, a confident fabrication is the worst sin — so bias to refuse.
    if (ASSEMBLER_G4_FLOOR and corpus and not asserts_grounded_value):
        q_stems = {t[:max(4, len(t) - 2)] for t in _dossier_tokens(question or "")}
        assertion = [t for t in _dossier_tokens(draft)
                     if t not in _G4_NARRATION
                     and t[:max(4, len(t) - 2)] not in q_stems]
        if len(assertion) >= G4_MIN_TOKENS:
            ungrounded = [t for t in assertion
                          if t[:max(4, len(t) - 2)] not in corpus]
            if (len(ungrounded) >= G4_MIN_UNGROUNDED
                    and len(ungrounded) / len(assertion) >= G4_FRAC):
                return ("refuse", GROUNDED_REFUSAL)

    return ("assert", draft)


def answer_assembler(question, memory_path, mems, model, host, timeout):
    """DEFAULT answer path: gather every channel -> dossier -> gemma thinks -> answer.

    Returns {"answer": str, "scenes": [cited kf frames]} — the same contract as ask().
    The dossier prompt enforces the provenance leash; the optional grounding gate
    (ASSEMBLER_GROUNDING_GATE) adds a second verification pass at ~2x latency."""
    timeout = max(timeout or 0, ASSEMBLER_MIN_TIMEOUT)
    channels = gather_evidence(question, memory_path, mems)
    dossier, cited = build_evidence_dossier(question, channels)
    if not dossier.strip():
        return {"answer": "I don't have that in my memory.", "scenes": []}
    draft = think_and_answer(question, dossier, model, host, timeout)
    # STRUCTURAL gate (deterministic, no second gemma call): assert only when the
    # answer is unambiguously bound to the asked entity AND any specific value it
    # asserts (a clock time, a logo) is read verbatim; refuse honestly or hedge on
    # ambiguity. Replaces the unreliable verify_grounded LLM gate (kept as fallback).
    if ASSEMBLER_GROUNDING_GATE:
        _verdict, text = structural_grounding(question, draft, memory_path)
        return {"answer": text, "scenes": cited}
    return {"answer": draft, "scenes": cited}


# --------------------------------------------------------------------------- #
# compose: thin back-compat dispatcher (reading vs general).
# --------------------------------------------------------------------------- #
def compose(question, scenes, model, host, timeout=60):
    """Back-compat wrapper: dispatch a retrieved-scene answer to reading/general."""
    if is_reading_question(question):
        return answer_reading(question, scenes, model, host, timeout)
    return answer_general(question, scenes, model, host, timeout)


# --------------------------------------------------------------------------- #
# Top-level routing.
# --------------------------------------------------------------------------- #
def ask(question, memory_path, model="gemma3:12b-it-qat",
        host="http://127.0.0.1:11434", timeout=60, k=4):
    mems = _resolve_memories(memory_path)
    kf, world, kf_path = mems["kf"], mems["world"], mems["kf_path"]

    if not kf and not world:
        return {"answer": "I haven't built a memory of your home yet.", "scenes": []}

    kind = classify_question(question)

    # 0a) audio/speech -> the voice transcript ONLY (refuse if no usable speech).
    #     Never let the visual layers answer "what was said" (the -12 failure).
    #     For sound-event questions (crying/yelling/noise) also consult the
    #     audio_events specialist so the detector's verdict supplements the
    #     transcript refusal, rather than leaving the user with only "no speech".
    if kind == "audio":
        transcript = load_transcript(memory_path)
        # Check whether the question is about non-speech sound events.
        _audio_event_words = {"cry", "crying", "cried", "yell", "yelling",
                              "scream", "screaming", "sound", "noise", "loud",
                              "hear", "heard", "music", "alarm", "siren"}
        _ql_words = set(question.lower().split())
        _wants_events = bool(_ql_words & _audio_event_words)
        if _wants_events:
            # Sound-event questions are answered from the CACHED capture-time log
            # (audio_events.json), built once by scripts/build_audio_events.py.
            # We do NOT re-open audio.wav at query time (the previous breach:
            # routing through _audio_events.answer() which called sf.read() on the
            # raw wav per question). Text in, text out — no raw media at query.
            events_log = load_audio_events(memory_path)
            if events_log is not None:
                return {"answer": answer_audio_events(
                    question, events_log, model, host, timeout), "scenes": []}
            # No cached log present -> fall through to the transcript-based answer
            # (still text-only). The raw wav is never touched here.
        return {"answer": answer_audio(question, transcript, model, host, timeout),
                "scenes": []}

    # 0b) egocentric direction -> refuse: no pose/heading is stored, so any
    #     left/right/which-side answer would be a guess. (Spatial-refusal gate kept.)
    if kind == "spatial":
        return answer_spatial(question, mems, memory_path)

    # Deterministic high-confidence slots take precedence over free-form
    # generation. The extractor returns nothing unless it can attach mechanical
    # repeat/consensus provenance, so unsupported questions continue unchanged.
    if _structured_recall is not None:
        try:
            structured = _structured_recall.recall(question, memory_path)
        except Exception:
            structured = None
        if structured and structured.get("answer"):
            scenes = [{"t": row.get("t"), "frame": row.get("frame"),
                       "source": row.get("channel")}
                      for row in structured.get("provenance") or []]
            return {"answer": structured["answer"], "scenes": scenes,
                    "structured_recall": structured}

    # ── DEFAULT: the THINKING ASSEMBLER ────────────────────────────────────── #
    # Everything that is NOT a pure-channel gate (audio-via-log, spatial-refusal)
    # now flows through the assembler: gather EVERY text channel into one dossier
    # and let gemma think across them. The per-intent specialists are no longer
    # exclusive routers — they are EVIDENCE PROVIDERS whose channels the assembler
    # already folds in (world inventory for counting, episodes for temporal, screen
    # reads for UI, micro-OCR for fine detail). This is the founder's centerpiece:
    # "the LLM that answers should have access to ALL this information."
    try:
        result = answer_assembler(question, memory_path, mems, model, host, timeout)
        if result and result.get("answer"):
            return result
    except Exception as _exc:
        # Surface, don't swallow: a crash here silently drops EVERY question to the
        # narrow legacy specialists (OCR-only), which reads as "honest refusals" while
        # the real brain never ran. That exact masking hid a total assembler failure on
        # the 'day in life' clip. Log loudly; still fall through so an answer is attempted.
        import traceback as _tb
        sys.stderr.write("[ask_home] ASSEMBLER CRASHED -> legacy fallback: %r\n" % _exc)
        _tb.print_exc()

    # ── LEGACY FALLBACK (only reached if the assembler errored/returned nothing) ─
    # 0c) screen / Claude-UI questions -> screen_reader specialist.
    if kind == "screen":
        if _screen_reader is not None and kf is not None:
            try:
                return {"answer": _screen_reader.answer(
                    question, kf, kf_path, model, host, timeout), "scenes": []}
            except Exception:
                pass  # fall through to generic reading path
        # Fallback: treat as a reading question if specialist unavailable.
        kind = "reading"

    # 1) counting -> counting_specialist (fallback: world inventory)
    if kind == "counting":
        if _counting_specialist is not None and kf:
            try:
                return {"answer": _counting_specialist.answer(
                    question, kf, world, model, host, timeout), "scenes": []}
            except Exception:
                pass  # fall through to ask_world
        if world:
            return {"answer": answer_counting(question, world, model, host, timeout),
                    "scenes": []}

    # 2) temporal -> temporal_specialist (fallback: old duration-index path)
    if kind == "temporal":
        if _temporal_specialist is not None and kf:
            try:
                return {"answer": _temporal_specialist.answer(
                    question, kf, kf_path, model, host, timeout), "scenes": []}
            except Exception:
                pass  # fall through to old path
        if kf_path:
            scenes = retrieve(question, kf, k=k, idf=_idf(kf)) if kf else []
            ans, proof = answer_temporal(question, kf_path, scenes, model, host, timeout, k=k)
            return {"answer": ans, "scenes": proof}

    # 3) reading/identity/place AND general -> keyframe retrieval (OCR+caption)
    if not kf:
        # Only a world file present + a non-counting question we can't ground in
        # frames: best-effort off the lossy world layer, no proof photos.
        return {"answer": ask_world(question, world, model, host, timeout) if world
                else "I don't have that in my memory of your home — I didn't see it.",
                "scenes": []}

    reading = (kind == "reading")
    scenes = _sem_retrieve(question, kf, kf_path, k=6)
    if scenes is None:
        scenes = retrieve(question, kf, k=k, idf=_idf(kf), ocr_boost=2.0 if reading else 1.0)
    if not scenes:
        return {"answer": "I don't have that in my memory of your home — I didn't see it.",
                "scenes": []}
    scenes = attribute_rerank(question, scenes, pool=kf)
    aq = resolve_item_term(question, scenes)
    if reading:
        answer = answer_reading(aq, scenes, model, host, timeout)
    else:
        answer = answer_general(aq, scenes, model, host, timeout)
    return {"answer": answer, "scenes": scenes}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("question", nargs="*")
    ap.add_argument("--memory", default="data/walks/home_capture_20260613/memory/memory_full.json")
    ap.add_argument("--model", default="gemma3:12b-it-qat")
    ap.add_argument("--self-test", action="store_true")
    args = ap.parse_args()
    if args.self_test:
        mem = [{"t": 5, "frame": "a.jpg", "description": "a black table fan on the windowsill"},
               {"t": 9, "frame": "b.jpg", "description": "a bed with a laptop on a tray"}]
        load_memory_records(mem)
        top = retrieve("where is my fan", mem)
        assert top and "fan" in top[0]["description"], top
        print("SELF-TEST PASS"); return 0
    q = " ".join(args.question)
    res = ask(q, args.memory, args.model)
    print("Q:", q)
    print("A:", res["answer"])
    for s in res["scenes"]:
        print("   proof: %ss  %s" % (s.get("t"), s.get("frame")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
