    "%s\n\nQuestion: %s\nAnswer:")


# --------------------------------------------------------------------------- #
# Per-layer answerers.
# --------------------------------------------------------------------------- #
def answer_reading(question, scenes, model, host, timeout):
    """Reading / identity / place / translation: fuse OCR (ground truth) with the
    caption and gemma's world knowledge to produce a concrete cited answer.

    Pure verbatim-quote questions withhold the caption so a recognised-by-sight
    detail cannot leak in as if it were read.
    """
    verbatim = bool(VERBATIM_RE.search(question.lower()))
    if verbatim:
        ctx = "\n".join(
            "[t=%ss] TEXT READ: %s" % (s.get("t"), s.get("_ocr_txt") or "(none)")
            for s in scenes)
        prompt = VERBATIM_PROMPT % (ctx, question)
    else:
        ctx = "\n".join(
            "[t=%ss] TEXT READ: %s\n         SEEN: %s"
            % (s.get("t"), s.get("_ocr_txt") or "(none)", s.get("caption", ""))
            for s in scenes)
        prompt = READING_PROMPT % (ctx, question)
    try:
        draft = _ollama(prompt, model, host, timeout)
    except Exception:
        s = scenes[0]
        return "Around %ss I read: %s" % (s.get("t"), s.get("_ocr_txt") or "(nothing readable)")
    if not verify_grounded(question, ctx, draft, model, host, timeout):
        return GROUNDED_REFUSAL
    return draft


def _fmt_scene(s):
    line = "- (at %ss) %s" % (s.get("t"), s.get("caption", s.get("description", "")))
    ocr = s.get("_ocr_txt")
    if ocr:
        line += "\n    (text read here: %s)" % ocr
    return line


# Honest refusal for egocentric direction: the keyframe memory has no pose/heading.
SPATIAL_REFUSAL = (
    "I remember what I saw and read, but not directions relative to where you were "
    "standing — I don't track left/right or which side of you things were on.")

GROUNDED_REFUSAL = "I don't have that in my memory — I didn't read enough to be sure."

# Phrases that already signal an honest don't-know; the grounding gate skips these
# (re-checking a refusal can only wrongly "support" or wrongly flag it).
REFUSAL_MARKERS = (
    "i don't have that", "i didn't read", "didn't see", "don't have it", "couldn't read",
    "i don't know", "no clear speech", "i didn't capture", "i don't track", "i had no",
    "didn't read enough", "i had trouble reaching")


def _is_refusal(text):
    t = (text or "").lower()
    return any(m in t for m in REFUSAL_MARKERS)


# Second pass: the failure left after the leash is "describes a retrieved-but-wrong
# item as if it answered" (asked the OTHER blue poster -> describes the X-ray one;
# asked the molecule poster's author -> names the yellow poster's). A focused binary
# fact-check catches that, where the buried rule in the answer prompt did not.
GATE_PROMPT = (
    "You are a strict fact-checker for a memory system. Below is the TEXT it actually\n"
    "read and saw in the relevant scenes, the QUESTION, and its DRAFT ANSWER.\n"
    "Reply UNSUPPORTED if ANY of these is true:\n"
    "- the draft states a person, brand, place name, or number that does NOT appear in\n"
    "  the TEXT;\n"
    "- the question asks about ONE specific item (a particular / 'other' / named poster,\n"
    "  sign, molecule, or object) but the TEXT does not actually contain THAT item — then\n"
    "  any answer naming or describing it is a guess. Example: asked who is on the\n"
    "  molecule poster, but the TEXT only shows a name on a station sign -> UNSUPPORTED;\n"
    "- the draft attributes a name/detail to the asked item that the TEXT ties to a\n"
    "  DIFFERENT item, or describes a different item than the one asked;\n"
    "- the draft adds biography, history, or facts not present in the TEXT;\n"
    "- the draft asserts a binary/occupancy STATE (crowded/empty, open/closed, on/off,\n"
    "  connected/unplugged, sent/unsent) by INFERENCE rather than a direct statement in the\n"
    "  TEXT (e.g. concluding 'crowded' from a sound event, or 'connected' from a cable);\n"
    "- the draft reports a vehicle or object as physically PRESENT (e.g. 'there was a train')\n"
    "  when the only evidence is a SINGLE blurred caption, or a mural/billboard/poster or an\n"
    "  ICON/drawing on a sign — a depicted or blurred image is not proof the thing was\n"
    "  really there -> UNSUPPORTED;\n"
    "- the question asks what ONE specific SIGN or POSTER says/translates (singular: 'the\n"
    "  german sign', 'the yellow poster'), but the TEXT holds several DIFFERENT signs/posters\n"
    "  and nothing in the question uniquely pins WHICH one — and the draft answers by reporting\n"
    "  (or stitching together) the text of one or more of them. Picking/merging a sign when the\n"
    "  asked one is not uniquely identified in the TEXT is a guess about which item was meant\n"
    "  -> UNSUPPORTED. (If the TEXT carries exactly ONE sign/poster of the asked kind, or the\n"
    "  question names/qualifies which one, reporting/translating it is fine.)\n"
    "Otherwise reply SUPPORTED. Translating words that ARE in the TEXT (e.g. German) into\n"
    "English is allowed and SUPPORTED when the asked sign/poster is the one those words are on.\n"
    "A draft that already says it doesn't know is\n"
    "SUPPORTED. Describing colours/shapes actually noted in the SEEN text is SUPPORTED.\n"
    "Reply with exactly ONE word: SUPPORTED or UNSUPPORTED.\n\n"
    "TEXT:\n%s\n\nQUESTION: %s\nDRAFT ANSWER: %s\n\nVerdict:")


# Enumeration questions ("what YEARS on EACH poster", "list ALL the names") are a
# blind spot for the single-item strict gate: gemma reads a correct multi-item list
# out of the dossier, but the gate — tuned to catch a wrong-ITEM claim — flags the
# whole list UNSUPPORTED and the correct answer is demoted. This deterministic
# pre-check recovers exactly that case WITHOUT re-opening the wrong-item hole:
#   * it fires ONLY when the QUESTION is phrased as an enumeration (each/all/how
#     many/what years/what names/list) — the wrong-item failures (Q2/Q9/Q10/Q25)
#     are all SINGULAR-item questions, so they never reach this path and stay on
#     the strict LLM gate;
#   * it requires the draft to assert at least one YEAR, and every year AND every
#     capitalised proper-name token the draft asserts must appear VERBATIM in the
#     dossier context (whitespace-normalised so "1845 - 1923" matches any spacing).
#     An invented year or a mis-named poster is not in the context -> no early pass,
#     fall through to the strict gate. It can only ever return True (never demote),
#     so a currently-passing answer cannot regress.
_ENUM_RE = re.compile(r"\b(each|all|how many|what years|which years|what names|list)\b", re.I)
_YEAR_RE = re.compile(r"\b(1[5-9]\d\d|20\d\d)\b")
_PROPER_RE = re.compile(r"\b[A-ZÄÖÜ][\wäöüß]{3,}\b")
_PREGATE_STOP = frozenset((
    "The", "This", "That", "There", "These", "Those", "They", "Additionally",
    "Below", "Above", "Also", "Each", "Both", "Read", "Answer", "Nobel"))


def _enumeration_pregate(question, context, draft):
    """Deterministic, LLM-free grounding for ENUMERATION answers. Returns True iff the
    question is an enumeration AND the draft asserts >=1 year AND every year and every
    capitalised proper-name token in the draft is present verbatim in `context`.
    Otherwise False -> caller falls through to the strict LLM gate unchanged."""
    if not _ENUM_RE.search(question or ""):
        return False
    years = _YEAR_RE.findall(draft or "")
    if not years:
        return False
    ctx = re.sub(r"\s+", " ", context or "")
    if any(y not in ctx for y in years):
        return False
    names = (n for n in _PROPER_RE.findall(draft or "") if n not in _PREGATE_STOP)
    if any(n not in ctx for n in names):
        return False
    return True


def verify_grounded(question, context, draft, model, host, timeout):
    """True if the draft is grounded in context. Conservative by design: an already
    honest refusal, any HTTP error, or an ambiguous reply all return True, so the gate
    only ever DEMOTES a confident answer it is sure is unsupported — it never invents."""
    if not draft or _is_refusal(draft):
        return True
    # Deterministic enumeration recovery (years + names verbatim in context). Only
    # ever short-circuits to grounded; never demotes -> cannot regress a passing answer.
    if _enumeration_pregate(question, context, draft):
        return True
    try:
        v = _ollama(GATE_PROMPT % (context, question, draft), model, host, timeout)
    except Exception:
        return True
    return "unsupported" not in v.strip().lower()[:40]


def answer_audio_events(question, events_log, model, host, timeout):
    """Non-speech sound-event question (crying/yelling/alarm/noise) -> answered
    from the CACHED capture-time audio-event log (audio_events.json) ONLY.

    The raw wave is never opened here: build_audio_events.py already turned it
    into this small text log at capture. If the capture was near-silent
    (usable_sound=false) we honestly report no detectable sound rather than
    invent a cry — that refusal is the channel working as designed.
    """
    if not events_log:
        return ("I didn't analyse an audio channel for this walk, so I can't tell "
                "you whether there were sounds like crying or yelling.")

    overall_db = events_log.get("overall_db")
    usable = events_log.get("usable_sound")
    events = events_log.get("events") or []
    db_txt = ("%.1f dB" % overall_db) if isinstance(overall_db, (int, float)) else "unknown level"

    if not usable:
        return ("No crying, yelling, or other distinct sound was detected — the "
                "captured audio was near-silent throughout this walk (overall "
                "%s, below the level at which any sound event registers). I'm "
                "answering from the sound analysis logged at capture, not by "
                "re-listening, so I won't invent a sound that wasn't there." % db_txt)

    if not events:
        return ("I analysed the captured sound and found no distinct events like "
                "crying, yelling, alarms, or music (overall %s). Nothing rose "
                "above ambient." % db_txt)

    # Usable audio WITH logged events: let gemma reason over the event TEXT.
    ev_lines = "\n".join(
        "- %s from %.1fs to %.1fs (confidence %.0f%%) [%s]"
        % (e.get("label"), e.get("start", 0.0), e.get("end", 0.0),
           100 * float(e.get("confidence", 0.0)), e.get("evidence", ""))
        for e in events)
    prompt = (
        "You are the sound memory of someone's day. At capture time the raw audio "
        "was analysed (energy, pitch, spectral shape — no transcription) into the "
        "event list below. Overall level: %s. Answer the question in 1-2 plain "
        "sentences using ONLY these logged events; cite the times. If no listed "
        "event matches what is asked, say it wasn't detected. Never invent a "
        "sound that is not in the list.\n\n"
        "Detected sound events:\n%s\n\nQuestion: %s\nAnswer:"
        % (db_txt, ev_lines, question))
    try:
        return _ollama(prompt, model, host, timeout)
    except Exception:
        return "I had trouble reaching my sound memory just now."


def answer_audio(question, transcript, model, host, timeout):
    """Spoken-word / heard-sound question -> the voice transcript ONLY.

    When the capture recorded no usable speech, this returns an honest 'I didn't
    hear it' instead of letting a visual layer confabulate words. When speech IS
    present, it answers from the transcript text (never from captions/OCR)."""
    if not transcript:
        return ("I didn't capture an audio channel for this walk, so I can't tell you "
                "what was said or heard.")
    if not transcript.get("usable_speech"):
        verdict = (transcript.get("verdict") or "no clear speech was detected").strip().rstrip(".")
        return ("I didn't capture clear speech — %s. So I can't tell you what was said "
                "or heard." % verdict)
    text = (transcript.get("text") or transcript.get("transcript")
            or transcript.get("raw_whisper") or "").strip()
    if not text:
        return "I had an audio channel but no transcribed words, so I can't tell you what was said."
    prompt = (
        "Below is the transcript of what was actually spoken/heard during a recording. "
        "Answer the question in 1-2 plain sentences using ONLY this transcript; quote the "
        "relevant words. If the transcript does not contain the answer, say you didn't hear "
        "it. Never invent speech.\n\nTranscript:\n%s\n\nQuestion: %s\nAnswer:" % (text, question))
    try:
        return _ollama(prompt, model, host, timeout)
    except Exception:
        return "I had trouble reaching my audio memory just now."


def answer_general(question, scenes, model, host, timeout):
    """General non-reading question: answer from caption (with OCR appended)."""
    ctx = "\n".join(_fmt_scene(s) for s in scenes)
    prompt = GENERAL_PROMPT % (ctx, question)
    try:
        draft = _ollama(prompt, model, host, timeout)
    except Exception:
        s = scenes[0]
        return "Around %ss: %s" % (s.get("t"), s.get("description"))
    if not verify_grounded(question, ctx, draft, model, host, timeout):
        return GROUNDED_REFUSAL
    return draft


def ask_world(question, objects, model, host, timeout=60):
    """Answer from the ONE deduplicated room memory (the product has no photos to
    show — it kept only this). No per-frame retrieval, no images returned."""
    inv = "\n".join("- %s (count: %s) — %s%s"
                    % (o.get("name"), o.get("count"),
                       o.get("attributes") or "",
                       ("; " + o["where"]) if o.get("where") else "")
                    for o in objects)
    prompt = (
        "This is your complete memory of one room — the distinct objects in it, how many "
        "of each, and their details. It is ALL you know; there are no photos. Answer the "
        "question in 1-2 plain sentences using ONLY this memory. For 'how many' questions "
        "give the count from the memory (do not add things up again). If it isn't in the "
        "memory, say you don't have it. Never invent.\n\n"
        "Memory of the room:\n%s\n\nQuestion: %s\nAnswer:" % (inv, question))
    try:
        return _ollama(prompt, model, host, timeout)
    except Exception:
        return "I couldn't reach my memory just now."


def answer_counting(question, world_objects, model, host, timeout):
    """Counting -> the deduplicated world inventory (already counted, no re-add)."""
    return ask_world(question, world_objects, model, host, timeout)


def answer_temporal(question, kf_path, scenes, model, host, timeout, k=4):
    """Temporal -> durations from the episode index. Returns (answer, proof_scenes).

    Degrades to a general best-effort over retrieved scenes if the index module
    is missing/broken so a temporal question still answers and never crashes.
    """
    if _temporal is None or kf_path is None:
        return (answer_general(question, scenes, model, host, timeout), scenes)

    idx = _temporal.get_durations(kf_path)
    episodes = idx.get("episodes", [])
    by_label = idx.get("by_label", {})
    total = idx.get("total_s", 0.0)
    if not episodes:
        return ("I don't have that in my memory — I didn't track the timing.", [])

    lines = ["Total time: %.1fs" % total, "Time spent per subject:"]
    for label, dur in sorted(by_label.items(), key=lambda x: -x[1]):
        lines.append("- %s: %.1fs" % (label, dur))
    lines.append("Episodes in order:")
    for ep in episodes:
        lines.append("- %s from %.1fs to %.1fs (%.1fs)"
                     % (ep["label"], ep["start"], ep["end"], ep["duration"]))
    ctx = "\n".join(lines)
    prompt = TEMPORAL_PROMPT % (ctx, question)

    # Proof frames: episodes the question names, else the longest episodes.
    ql = question.lower()
    named = [ep for ep in episodes if ep["label"] in ql]
    chosen = named[:k] if named else sorted(episodes, key=lambda e: -e["duration"])[:k]
    proof = [{"t": ep.get("t"),
              "frame": ep["frames"][0] if ep.get("frames") else None}
             for ep in chosen]

    try:
        ans = _ollama(prompt, model, host, timeout)
    except Exception:
        ans = ctx
    return (ans, proof)


# --------------------------------------------------------------------------- #
# THINKING ASSEMBLER — the centerpiece.
#
# The founder's brief: "the LLM that answers should have access to ALL this
# information from which it can think, assemble the concepts, and answer."
#
# This is the DEFAULT answer path. Instead of routing a question to ONE specialist
# that sees only its own channel, the assembler GATHERS evidence from EVERY text
# channel that exists next to the memory (all are text files — keyframe OCR+caption,
# region micro-OCR, the deduped world inventory, the speech transcript, the sound-
# event log, screen/UI reads, and temporal episodes), pulls the items relevant to
# the question out of each, tags every line with its SOURCE + TIMESTAMP, and folds
# them into ONE structured EVIDENCE DOSSIER. gemma then THINKS over the whole
# dossier — reasoning across channels — and answers on a strict provenance leash.
#
# It NEVER opens raw media: audio/screen/region channels are read from their cached
# capture-time TEXT logs (the no-raw-storage contract). The per-intent specialists
# stay as EVIDENCE PROVIDERS (they fill channels / handle the pure-channel gates),
# not exclusive routers.
#
# Function pair drafted by local qwen2.5-coder:14b per the founder mandate, then
# hardened here (defensive .get on every field, keyword-filtered & capped screen
# channel, frame-citation carried through, dossier-keyword stopwords reuse STOP).
# --------------------------------------------------------------------------- #
ASSEMBLER_MAX_PER_CHANNEL = 10  # was 6: a multi-scene DAY (130 keyframes) needs more
# per-channel recall than a sparse walk, or the one frame carrying the answer (the
# lecturer's name, the game HUD, the breakfast) never makes the cut and the assembler
# refuses a fact it actually captured. The grounding gate still guards hallucination.
# Captions are the read TEXT's context, not the answer; the verbose gemma captions
# (200-400 words each) bloat the dossier and slow reasoning past the caller's timeout
# without adding signal the OCR doesn't carry. Cap each caption in the dossier.
ASSEMBLER_CAPTION_CHARS = 320
# The assembler reasons over a multi-channel dossier (often several thousand tokens),
# so gemma needs more wall-clock than a single-scene answer. Floor the timeout here so
# a tight caller default (60s) can't truncate the think step into a reach-failure.
ASSEMBLER_MIN_TIMEOUT = 180
# KF channel only: the literal ranker scores every science-poster/door frame on the
# SAME generic surface words ('poster', 'sign', 'german', 'name'), so the frame that
# actually carries the answer can lose to a same-genre distractor whose caption merely
# repeats those words (Q14 'molecule poster' lost to the RÖNTGEN frame; Q2's door sign
# never surfaced). Two recall-ADDITIVE levers fix this without dropping any frame:
#   * FOCUS: reward the frame whose text matches the question's DISTINCTIVE tokens
#     ('molecule' -> the Fischer chlorophyll frame), after stripping the generic
#     surface words shared across the genre. Reinforces the right frame; never evicts.
#   * SEMANTIC UNION: always carry the embedder's top frames into the channel, even at
#     literal+focus overlap 0 (Q13 already relies on this; the door cluster for Q2).
# The KF cap is widened a little so these are added beside — not in place of — the
# literal top frames the already-correct questions depend on.
ASSEMBLER_KF_MAX = 16
ASSEMBLER_KF_FOCUS_WEIGHT = 6.0
ASSEMBLER_KF_SEM_UNION = 6
# Generic visual-surface words: the genre vocabulary every poster/sign/door frame
# shares. Stripped from a question before the FOCUS step so only a truly distinctive
# noun (molecule, chlorophyll, elevator) steers the channel, not 'poster'/'sign'.
KF_GENERIC_WORDS = {
    "poster", "posters", "sign", "signs", "signage", "signboard", "signpost",
    "board", "boards", "billboard", "mural", "plaque", "panel", "placard",
    "banner", "notice", "label", "labels", "door", "wall", "text", "word",
    "words", "name", "names", "named", "say", "said", "says", "reads", "read",
    "written", "writing", "mentioned", "thing", "things", "translate",
    "translated", "translation", "german", "germany", "english", "language",
    "letters", "writes",
}


def _clip(text, n):
    """Trim to n chars on a word boundary, with an ellipsis, for the dossier."""
    text = (text or "").strip()
    if len(text) <= n:
        return text
    cut = text[:n].rsplit(" ", 1)[0]
    return cut + " …"


def _dossier_tokens(text):
    """Question keywords for relevance scoring: lowercase tokens length>=3 (or a
    bare number), minus the shared STOP set. Numbers stay (years/codes discriminate)."""
    return {w for w in _tokens(text) if (len(w) >= 3 or w.isdigit()) and w not in STOP}


def _score_overlap(text, keywords):
    """How many question keywords appear in `text` (counts repeats — a line that
    mentions the asked thing several times is the one it is about)."""
    if not keywords:
        return 0
    toks = _tokens(text)
    return sum(1 for t in toks if t in keywords)


def _distinctive_tokens(question):
    """The question's keywords MINUS the genre's generic surface vocabulary (and
    colour words, which the attribute path already handles). What's left is the
    noun that actually separates one frame from its same-genre neighbours — e.g.
    'molecule' for the Fischer chlorophyll panel vs the RÖNTGEN X-ray panel. Empty
    when every word is generic (e.g. 'what did the german sign translate to') — the
    FOCUS step then no-ops and the literal ranking + semantic union still apply."""
    return {w for w in _dossier_tokens(question)
            if w not in KF_GENERIC_WORDS and w not in COLOUR_WORDS}


def _focus_hits(text, dtokens):
    """How many DISTINCTIVE question tokens the frame's text carries, matched on a
    short stem so morphological/cross-language variants bridge (molecule<->molecular,
    chlorophyll<->Chlorophyll). 0 when the frame is off-topic for the asked item."""
    if not dtokens:
        return 0
    low = (text or "").lower()
    hits = 0
    for d in dtokens:
        stem = d[:max(4, len(d) - 2)]
        if stem and stem in low:
            hits += 1
    return hits


# Stem length for ENTITY-CHANNEL referent resolution. The KF channel has a semantic
# embedder (bge-m3) to bridge an English question noun to a foreign-language read on
# the sign; the entity channels do NOT. A 4-char prefix lets the referent noun the
# question names bridge its cross-language / morphological form in the bound record
# itself (molecule -> "Molekül", the SAME poster's own text) so the named item's record
# is resolved instead of a louder same-genre distractor's. Generic: no clip/answer
# literal — just a shorter prefix than _focus_hits' max(4, len-2), which is too long for
# longer nouns (molecule -> "molecu", which does NOT bridge "molekül"). Empty dtokens
# -> 0 for every record, so a generic question is scored exactly as before (no-op).
_REFERENT_STEM_LEN = 4


def _referent_focus_hits(text, dtokens):
    """Like _focus_hits but with a short fixed stem (_REFERENT_STEM_LEN) so a referent
    noun bridges its cross-language / inflected form in an entity record's OWN text.
    Used only on the entity channels (which lack the KF channel's semantic union) to
    pick the SPECIFIC named referent's bound record. 0 when off-referent or generic."""
    if not dtokens:
        return 0
    low = (text or "").lower()
    hits = 0
    for d in dtokens:
        stem = d[:_REFERENT_STEM_LEN] if len(d) >= _REFERENT_STEM_LEN else d
        if stem and stem in low:
            hits += 1
    return hits


def gather_evidence(question, memory_path, mems):
    """Collect EVERY text channel sitting next to the memory into one dict for the
    assembler. Each value is an already-parsed Python object (or None). Reads only
    cached text logs — never raw audio.wav / JPEG pixels (the no-raw-storage law).

    Returns: {"kf","micro","world","transcript","audio_events","screen","episodes"}.
    """
    base = os.path.dirname(os.path.abspath(memory_path))
    kf = mems.get("kf")
    world = mems.get("world")
    kf_path = mems.get("kf_path")

    def _load_json(name):
        p = os.path.join(base, name)
        if os.path.exists(p):
            try:
                return json.load(open(p))
            except Exception:
                return None
        return None

    micro = _load_json("micro_details.json")
    if not isinstance(micro, list):
        micro = None
    screen = _load_json("screen_memory.json")
    if not isinstance(screen, list):
        screen = None

    transcript = load_transcript(memory_path)
    audio_log = load_audio_events(memory_path)

    episodes = None
    if _temporal is not None and kf_path:
        try:
            episodes = _temporal.get_durations(kf_path).get("episodes") or None
        except Exception:
            episodes = None

    # --- OBJECT ATTRIBUTES (per-frame colour/zip/cable observations) --------- #
    try:
        attr_log = _load_json("attributes.json")
        if not isinstance(attr_log, list):
            attr_log = None
    except Exception:
        attr_log = None

    # --- SLEEP-PASS BOUND MEMORY (cross-channel entity bindings) ------------- #
    try:
        bound = _load_json("bound_memory.json")
        if not isinstance(bound, dict):
            bound = None
        elif _provenance_matches is None or not _provenance_matches(bound, base):
            # A stale or foreign sleep summary is worse than no summary: it looks
            # grounded while injecting another clip's facts into this one.
            bound = None
        elif bound.get("usable") is False:
            bound = None
        elif ("usable" not in bound
              and (not (bound.get("entities") or bound.get("bindings"))
                   or bound.get("summary") == "PARSE_ERROR")):
            bound = None
    except Exception:
        bound = None

    # Persistent entities produced by capture -> cross-frame re-identification.
    # Unlike loose captions, these records keep each attribute on its owner.
    entity_centric = _load_json("entity_centric.json")
    if not isinstance(entity_centric, list):
        entity_centric = None

    # --- ENTITY-CENTRIC CAPTURE (NDJSON; attributes bound at capture) ------- #
    entity_capture = None
    try:
        entity_path = os.path.join(base, "entity_capture.json")
        if os.path.exists(entity_path):
            parsed_rows = []
            with open(entity_path) as entity_file:
                raw_text = entity_file.read()
            # build_entity_capture.py writes the final file as a JSON array; the
            # resume checkpoint (.ckpt.ndjson) and test fixtures are NDJSON. Accept
            # both so the binding is never silently dropped on a format mismatch.
            try:
                whole = json.loads(raw_text)
                if isinstance(whole, list):
                    parsed_rows = [r for r in whole if isinstance(r, dict)]
                elif isinstance(whole, dict):
                    parsed_rows = [whole]
            except Exception:
                for line in raw_text.splitlines():
                    if not line.strip():
                        continue
                    try:
                        row = json.loads(line)
                    except Exception:
                        continue
                    if isinstance(row, dict):
                        parsed_rows.append(row)
            entity_capture = parsed_rows or None
    except Exception:
        entity_capture = None

    return {"kf": kf, "kf_path": kf_path, "micro": micro, "world": world,
            "transcript": transcript, "audio_events": audio_log, "screen": screen,
            "episodes": episodes, "attr_log": attr_log, "bound": bound,
            "entity_capture": entity_capture, "entity_centric": entity_centric}


def _flatten_text(v):
    """Coerce a channel field that may be str | list | None into clean text.
    build_world_memory's 'where'/'attributes' shape varies by clip; this keeps the
    dossier builder from crashing on a list (the bug that took the assembler down on
    the 'day in life' clip and masqueraded as honest refusals)."""
    if v is None:
        return ""
    if isinstance(v, (list, tuple)):
        return ", ".join(_flatten_text(x) for x in v if x not in (None, ""))
    if isinstance(v, dict):
        return ", ".join("%s: %s" % (k, _flatten_text(val)) for k, val in v.items())
    return str(v).strip()


def build_evidence_dossier(question, channels, max_per_channel=ASSEMBLER_MAX_PER_CHANNEL):
    """Build ONE structured EVIDENCE DOSSIER string from all text channels.

    Per channel: rank items by how many question keywords they contain (then by how
    much text they carry — the richest read wins ties), keep the top `max_per_channel`,
    and emit a clearly delimited section with each line tagged by source + timestamp.
    If nothing in a channel overlaps the question we still keep the top items (so
    cross-channel reasoning is possible), capped the same way. Channels that exist but
    are unusable (silent audio / no speech) get a one-line honest note so the model
    knows they were checked, not skipped.

    Drafted by qwen2.5-coder:14b; hardened for missing fields and citation carry.
    Returns (dossier_str, cited_scenes) — cited_scenes are the kf items surfaced into
    the dossier, used as the {answer, scenes} proof frames.
    """
    kw = _dossier_tokens(question)
    # Distinctive (non-generic) question tokens — the noun(s) that pick out the SPECIFIC
    # referent the question names ('molecule', 'elevator') rather than the genre word
    # ('poster','sign'). Reused below to guarantee the named referent's OWN entity record
    # survives the per-channel cap instead of being out-ranked by a louder distractor.
    # Empty for generic questions, in which case every referent-priority step no-ops and
    # the existing literal-overlap ranking is unchanged.
    dtok_ref = _distinctive_tokens(question)
    parts = []
    cited = []

    # --- VISUAL TEXT READ (kf OCR) + SCENE CAPTIONS --------------------------- #
    kf = channels.get("kf") or []
    kf_path = channels.get("kf_path")
    if kf:
        def _kf_text(m):
            return (m.get("caption", "") or m.get("description", "")) + " " + (m.get("_ocr_txt", "") or "")
        # --- Strong retrieval, wired INTO the assembler (previously dead code reached
        # only in the legacy fallback). Fixes the wrong-binding bugs where the answer is
        # in the OCR but the literal top-6 grabbed the wrong frame:
        #   * resolve_item_term: 'bag'->'backpack' when the synonym dominates the frames
        #   * _sem_retrieve (bge-m3): bridges vocab gaps the literal ranker misses
        #       (molecule<->Molekuel, crowded<->empty/platform, poster<->signpost)
        #   * attribute_rerank FOCUS: for a COLOUR/MATERIAL question, drop the same-noun
        #       distractor (the gray bin-bag) instead of packing it beside the answer
        #   * DISTINCTIVE-TOKEN FOCUS: for a same-genre question ('who is on the MOLECULE
        #       poster?'), reward the frame matching the asked item's distinctive noun
        #       so it out-ranks a sibling whose caption only repeats 'poster'/'sign'
        #   * SEMANTIC UNION: carry the embedder's top frames in unconditionally, so a
        #       frame at literal+focus overlap 0 (the door sign for the German question)
        #       is still present for the model to read
        # Guarded: degrades to today's exact literal ranking when the embedder is down;
        # the focus bonus only reinforces an on-item frame and never evicts a literal
        # winner (the cap is widened so additions sit BESIDE the existing top frames).
        aq = resolve_item_term(question, kf)
        qk = _dossier_tokens(aq)
        dtok = _distinctive_tokens(aq)
        sem = _sem_retrieve(aq, kf, kf_path, k=12) or []
        sem_score = {(s.get("t"), s.get("frame")): float(s.get("_sem_score") or 0.0) for s in sem}
        q_col, q_mat, _qt = _question_attributes(aq)
        pool = kf
        if q_col or q_mat:
            focused = attribute_rerank(aq, list(kf), pool=kf, max_scenes=None)
            if focused and len(focused) < len(kf):
                pool = focused
        kf_cap = max(max_per_channel, ASSEMBLER_KF_MAX)
        def _kf_rank(m):
            ss = sem_score.get((m.get("t"), m.get("frame")), 0.0)
            fh = _focus_hits(_kf_text(m), dtok)
            return (_score_overlap(_kf_text(m), qk) + 2.0 * ss
                    + ASSEMBLER_KF_FOCUS_WEIGHT * fh,
                    len(m.get("_ocr_txt", "") or ""))
        ranked = sorted(pool, key=_kf_rank, reverse=True)[:kf_cap]
        # Union in the embedder's strongest frames even when literal+focus put them
        # outside the cap — recall-additive, so a frame whose answer text the literal
        # ranker can't see (no shared surface words) still reaches the model.
        if sem:
            sem_sorted = sorted(
                sem, key=lambda s: -float(s.get("_sem_score") or 0.0))[:ASSEMBLER_KF_SEM_UNION]
            ranked = _merge_scenes(ranked, sem_sorted, cap=kf_cap + ASSEMBLER_KF_SEM_UNION)
        if ranked:
            parts.append("=== VISUAL TEXT READ (OCR) & SCENE CAPTIONS ===")
            for m in ranked:
                ocr = m.get("_ocr_txt") or "(none)"
                cap = _clip(m.get("caption", "") or m.get("description", ""), ASSEMBLER_CAPTION_CHARS)
                parts.append("[t=%ss] READ: %s | SEEN: %s" % (m.get("t"), ocr, cap))
                cited.append(m)

    # --- REGION OCR (fine detail) -------------------------------------------- #
    micro = channels.get("micro") or []
    if micro:
        def _micro_text(r):
            return " ".join(r.get("micro_ocr") or [])
        ranked = sorted(
            micro, key=lambda r: (_score_overlap(_micro_text(r), kw), len(_micro_text(r))),
            reverse=True)[:max_per_channel]
        ranked = [r for r in ranked if _micro_text(r).strip()]
        if ranked:
            parts.append("=== REGION OCR (fine detail) ===")
            for r in ranked:
                parts.append("[t=%ss region %s] %s"
                             % (r.get("t"), r.get("region", "?"), " | ".join(r.get("micro_ocr") or [])))

    # --- OBJECT INVENTORY (deduped world) ------------------------------------ #
    world = channels.get("world") or []
    if world:
        def _w_text(o):
            return "%s %s %s" % (o.get("name", ""), o.get("attributes", "") or "", o.get("where", "") or "")
        ranked = sorted(world, key=lambda o: _score_overlap(_w_text(o), kw), reverse=True)[:max_per_channel]
        if ranked:
            parts.append("=== OBJECT INVENTORY (deduped, already counted) ===")
            for o in ranked:
                # build_world_memory's fields vary by clip: 'attributes'/'where' may be a
                # str OR a list. The walk emitted strings; the 'day in life' clip emitted
                # lists, which crashed the WHOLE assembler (str + list) — silently swallowed
                # by ask()'s fallback, so every question dropped to the OCR-only legacy path
                # and refused. Coerce to text so the brain's reasoning path actually runs.
                attrs = _flatten_text(o.get("attributes"))
                w = _flatten_text(o.get("where"))
                where = (" | where: " + w) if w else ""
                parts.append("- %s (x%s): %s%s" % (o.get("name"), o.get("count"), attrs, where))

    # --- SPEECH TRANSCRIPT --------------------------------------------------- #
    transcript = channels.get("transcript")
    if transcript:
        if transcript.get("usable_speech"):
            text = (transcript.get("text") or transcript.get("transcript")
                    or transcript.get("raw_whisper") or "").strip()
            parts.append("=== SPEECH TRANSCRIPT ===")
            parts.append(text or "(channel present but no transcribed words)")
        else:
            verdict = (transcript.get("verdict") or "no clear speech detected").strip()
            parts.append("=== SPEECH TRANSCRIPT === (no usable speech: %s)" % verdict)

    # --- SOUND EVENTS -------------------------------------------------------- #
    audio_log = channels.get("audio_events")
    if audio_log:
        db = audio_log.get("overall_db")
        db_txt = ("%.1f dB" % db) if isinstance(db, (int, float)) else "unknown level"
        if audio_log.get("usable_sound") and (audio_log.get("events") or []):
            parts.append("=== SOUND EVENTS (overall %s) ===" % db_txt)
            for e in audio_log.get("events") or []:
                parts.append("- %s from %.1fs to %.1fs (confidence %.0f%%)"
                             % (e.get("label"), e.get("start", 0.0), e.get("end", 0.0),
                                100 * float(e.get("confidence", 0.0))))
        else:
            parts.append("=== SOUND EVENTS === (audio near-silent, overall %s — no distinct sound)" % db_txt)

    # --- SCREEN / UI READS --------------------------------------------------- #
    screen = channels.get("screen") or []
    if screen:
        def _s_text(r):
            return r.get("screen_ocr_txt", "") or " ".join(r.get("screen_ocr") or [])
        ranked = [r for r in screen if _s_text(r).strip()]
        ranked = sorted(
            ranked, key=lambda r: (_score_overlap(_s_text(r), kw), len(_s_text(r))),
            reverse=True)[:max_per_channel]
        # Derive two STRUCTURAL hints the raw OCR dump hides (pure observation, no
        # state asserted, no colour invented). These name WHICH ocr line is the open
        # chat's title and WHICH block is the user's unsent compose-box message, so
        # the assembler can answer "which chat is asking for input" / "what was typed
        # but not sent" by NAMING them instead of describing body text. Generalizes:
        # keyed on UI structure (title-bar 'A / B' breadcrumb; a first-person
        # imperative message in the input area), not on any specific chat name.
        _open_chat = None
        _title_re = re.compile(r"^\s*\S.*\s/\s.*\S")  # 'Workspace / Chat title' bar
        for _r in screen:
            for _line in (_r.get("screen_ocr") or [])[:2]:
                if _line and _title_re.match(_line):
                    _open_chat = (_r.get("t"), _line.strip())
                    break
            if _open_chat:
                break
        _draft = None
        _first_re = re.compile(r"\b(i'm|i am|im a|my |i want|i need)\b", re.I)
        _ask_re = re.compile(
            r"\b(give me|first give|you need to|tell me|help me|can you)\b", re.I)
        for _r in screen:
            _lines = [l for l in (_r.get("screen_ocr") or []) if l and l.strip()]
            _prose = [l for l in _lines if len(l) > 35 and " " in l]
            _block = " ".join(_prose)
            # An unsent draft = a long FIRST-PERSON message with an imperative request
            # sitting in the input area (distinct from third-person instruction docs).
            if (len(_prose) >= 4 and _first_re.search(_block.lower())
                    and _ask_re.search(_block.lower())):
                if not _draft or len(_block) > len(_draft[1]):
                    _draft = (_r.get("t"), _block)
        if ranked:
            parts.append("=== SCREEN / UI READS ===")
            if _open_chat:
                parts.append(
                    "OPEN CHAT (active window/title bar, t=%ss): %s  <- this is the"
                    " chat currently open and awaiting input; name THIS chat for"
                    " 'which chat is asking for input'."
                    % (_open_chat[0], _open_chat[1]))
            if _draft:
                parts.append(
                    "UNSENT DRAFT (compose box, t=%ss): \"%s\"  <- a message typed into"
                    " the input box but not yet sent (OCR is approximate)."
                    % (_draft[0], _draft[1]))
            for r in ranked:
                parts.append("[t=%ss] %s" % (r.get("t"), _s_text(r)))

    # --- OBJECT ATTRIBUTES (colour / zip / cable / material per frame) ------- #
    attr_log = channels.get("attr_log") or []
    if attr_log:
        def _attr_text(a):
            obj = a.get("object", "")
            attrs = a.get("attributes") or {}
            return obj + " " + " ".join("%s:%s" % (k, v) for k, v in attrs.items())
        ranked_attrs = sorted(
            attr_log,
            key=lambda a: (_score_overlap(_attr_text(a), kw),
                           0 if (a.get("confidence") or "") == "low" else 1),
            reverse=True)[:max_per_channel]
        if ranked_attrs:
            # Per-frame lines: drop the internal provenance noise fields and the
            # cable model's own "plugged_in" guess (an inference, not an observation
            # of a connected device) so colour / colour_tint / zip / material /
            # cable_present read cleanly.
            _attr_noise = {"colour_source", "colour_pixel", "colour_vlm",
                           "colour_confidence", "cable_connected"}
            parts.append("=== OBJECT ATTRIBUTES ===")
            for a in ranked_attrs:
                obj = a.get("object", "?")
                attrs = a.get("attributes") or {}
                conf = a.get("confidence", "?")
                attr_str = "; ".join("%s=%s" % (k, v) for k, v in attrs.items()
                                     if v and v != "unknown" and k not in _attr_noise)
                if attr_str:
                    parts.append("[t=%ss] %s: %s (confidence: %s)"
                                 % (a.get("t"), obj, attr_str, conf))
            # Per-object SUMMARY over ALL frames (not just the top-N shown above) so a
            # faint signal that loses the keyword-rank cut still reaches the model:
            # the washed-out colour tint, and whether a cable was ever present. Pure
            # observation — no state is asserted here; the leash decides how to phrase.
            _objs = {}
            for a in attr_log:
                _objs.setdefault(a.get("object", "?"), []).append(a)
            _summ = []
            for _o, _es in _objs.items():
                if _o == "?":
                    continue
                _bits = []
                _cols = sorted({(e.get("attributes") or {}).get("colour")
                                for e in _es
                                if (e.get("attributes") or {}).get("colour")
                                not in (None, "unknown")})
                _tints = sorted({((e.get("t")), (e.get("attributes") or {}).get("colour_tint"))
                                 for e in _es
                                 if (e.get("attributes") or {}).get("colour_tint")
                                 not in (None, "none", "unknown")})
                if _cols:
                    _bits.append("colour read out as %s, but at LOW saturation —"
                                 " a washed-out / near-%s capture, NOT a confident"
                                 " solid colour"
                                 % ("/".join(_cols), "/".join(_cols)))
                if _tints:
                    _bits.append("faint/inconsistent colour tint(s) also seen (a"
                                 " low-saturation capture wash-out, not a solid"
                                 " colour): "
                                 + ", ".join("%s at t=%ss" % (tn, t)
                                             for t, tn in _tints))
                _pres = sorted({((e.get("t")), (e.get("attributes") or {}).get("cable_present"))
                                for e in _es
                                if (e.get("attributes") or {}).get("cable_present")
                                not in (None, "unknown")})
                _yes = [t for t, p in _pres if p == "yes"]
                _no = [t for t, p in _pres if p == "no"]
                if _yes:
                    _bits.append("a cable/wire was present at t=%s"
                                 % ",".join("%ss" % t for t in _yes))
                if _no:
                    _bits.append("no cable seen at t=%s"
                                 % ",".join("%ss" % t for t in _no))
                if _bits:
                    _summ.append("%s: %s" % (_o, "; ".join(_bits)))
            # If a cable was tracked but NO phone object exists in the inventory,
            # say so plainly — this is the grounded basis for a "can't confirm a
            # phone connection" answer, NOT a license to infer one.
            _has_phone = any(
                ("phone" in (a.get("object", "") or "").lower())
                for a in attr_log)
            _has_cable = any(a.get("object") == "laptop_cable" for a in attr_log)
            if _has_cable and not _has_phone:
                _summ.append("NOTE: no phone/iPhone object was detected in any"
                             " frame (only a laptop and a cable were seen), so a"
                             " phone-to-laptop connection cannot be confirmed.")
            if _summ:
                parts.append("OBJECT SUMMARY (across all frames):")
                parts.extend("  - " + s for s in _summ)

    # --- ENTITY CAPTURE (attributes bound to a person/object at capture) ---- #
    entity_capture = [r for r in (channels.get("entity_capture") or [])
                      if isinstance(r, dict) and r.get("parse_ok") is True]
    if entity_capture:
        # Build a focused temporal relation block over ALL valid capture rows before surfacing
        # individual frames. This binds OCR variants to one continuous object/person episode and
        # explicitly keeps incompatible or temporally distant reads from becoming one answer.
        try:
            from same_event_relations import compact_relation_summary
            relation_summary = compact_relation_summary(
                entity_capture, question, limit=max(1, min(4, max_per_channel)))
            if relation_summary:
                parts.append(relation_summary)
        except Exception:
            # Relation indexing is additive evidence; malformed optional structure must never take
            # down the base entity-capture dossier.
            pass

        def _entity_capture_text(row):
            return _flatten_text({
                "persons": row.get("persons") or [],
                "text_objects": row.get("text_objects") or [],
                "self_attributes": row.get("self_attributes") or {},
            })

        # REFERENT-PRIORITY ranking: when the question names a specific item (it has
        # distinctive tokens), a row whose own text carries that distinctive noun is
        # ranked FIRST, ahead of rows that merely repeat the genre word. This keeps the
        # named referent's own bound record (e.g. the MOLECULE poster's row) from being
        # truncated out by a louder same-genre distractor before it reaches the model.
        # Generic question (dtok_ref empty) -> _focus_hits is 0 for all rows -> identical
        # to the prior pure literal-overlap ordering.
        # Rank by REFERENT match first (the short-stem bridge that resolves the named
        # item's own bound record across a language/inflection gap the 6-char _focus_hits
        # misses), then the prior _focus_hits / literal-overlap / length order so already
        # correct questions are unchanged. Generic question (dtok_ref empty) -> both focus
        # terms are 0 for every row -> identical to the prior pure literal-overlap ordering.
        def _cap_key(r):
            txt = _entity_capture_text(r)
            return (_referent_focus_hits(txt, dtok_ref),
                    _focus_hits(txt, dtok_ref),
                    _score_overlap(txt, kw),
                    len(txt))
        ranked_all_rows = sorted(entity_capture, key=_cap_key, reverse=True)
        surfaced_entity_rows = ranked_all_rows[:max_per_channel]
        # PER-REFERENT GUARANTEE (Mode-3): if the question names a specific item and a row
        # actually resolves to it (short-stem referent hit) but that row was truncated out
        # by the per-channel cap, splice the single best-resolved row back in. This is the
        # named referent's OWN record; without it the model can only see louder same-genre
        # distractors (the molecule poster lost to the more numerous RÖNTGEN rows). No-op
        # for a generic question (no row scores a referent hit) and additive (it never
        # evicts a surfaced row — it appends one resolved record), so it cannot force an
        # answer where the referent was never observed.
        if dtok_ref:
            resolved = [r for r in ranked_all_rows
                        if _referent_focus_hits(_entity_capture_text(r), dtok_ref)]
            if resolved and not any(
                    _referent_focus_hits(_entity_capture_text(r), dtok_ref)
                    for r in surfaced_entity_rows):
                surfaced_entity_rows = surfaced_entity_rows + [resolved[0]]
        parts.append("=== ENTITY CAPTURE (who-wore-what, bound at the moment of capture) ===")
        # ENTITY-RESOLUTION lead-in: when the question names a specific item and exactly
        # ONE genre of record resolves to it (short-stem referent hit) while other records
        # of the same genre do NOT, name the resolved record(s) up front and steer the
        # answer to THAT record's bound text. Directly fixes the wrong-entity binding: the
        # model reads "the record for the item you asked about is t=Xs: <its own text>"
        # before it sees the louder distractor rows. Purely structural — the timestamps and
        # text are the capture's own, no clip/answer literal — and it only fires when the
        # referent resolves uniquely, so a generic or unresolved question is untouched.
        if dtok_ref:
            resolved_rows = [r for r in ranked_all_rows
                             if _referent_focus_hits(_entity_capture_text(r), dtok_ref)]
            if resolved_rows:
                # Collect this referent's bound text-objects, richest read first (a name
                # line carries more than a stray fragment), deduped by surface text so the
                # block leads with the answer-bearing line, not repeated noise.
                resolved_objs = []
                for r in resolved_rows[:3]:
                    ts = r.get("t")
                    for obj in r.get("text_objects") or []:
                        if isinstance(obj, dict) and obj.get("object") and obj.get("logo_or_text"):
                            resolved_objs.append((ts, _flatten_text(obj.get("object")),
                                                  _flatten_text(obj.get("logo_or_text"))))
                # Order the referent's own lines so the answer-bearing ones lead: a line
                # that is itself a proper name (a short ALL-CAPS / Capitalised token run,
                # the "who/what is named" answer) first, then question-keyword overlap,
                # then richer reads. Pure surface signals — no clip/answer literal.
                def _name_like(s):
                    return 1 if re.search(r"\b[A-Z][A-Za-z]+(?:\s+[A-Z][A-Za-z]+)+\b", s or "") \
                        and len((s or "").split()) <= 5 else 0
                resolved_objs.sort(
                    key=lambda o: (_name_like(o[2]),
                                   _score_overlap(o[2], kw),
                                   len(o[2])),
                    reverse=True)
                resolved_lines = []
                seen_text = set()
                # OVER-MATCH GUARD: the short referent stem (_REFERENT_STEM_LEN) is
                # deliberately permissive so it can bridge a cross-language / inflected
                # form (the question noun -> its foreign spelling on the item's own
                # record). That same looseness lets an UNRELATED same-prefix word resolve
                # a record that is NOT the asked item (a question noun whose first chars
                # coincide with an off-topic foreign word on a different sign). Such a
                # record carries the stem but neither a proper NAME the question could be
                # asking for nor ANY other question keyword. Only treat a resolved line as
                # genuinely on-referent — and only then emit the steering block — when the
                # line carries a proper-name run (_name_like, the "who/what is named"
                # answer) OR shares >=1 question keyword (_score_overlap). A line that has
                # the bare stem and nothing else is dropped, so a spurious same-prefix
                # match produces no misleading block. Purely structural; no clip/answer
                # literal; degrades to no block when nothing qualifies.
                block_ok = False
                for ts, obj_name, logo in resolved_objs:
                    key = logo.lower()
                    if key in seen_text:
                        continue
                    on_referent = bool(_name_like(logo)) or _score_overlap(logo, kw) > 0
                    if not on_referent:
                        continue
                    seen_text.add(key)
                    block_ok = True
                    resolved_lines.append(
                        _clip('[t=%ss] %s — text: "%s"' % (ts, obj_name, logo), 320))
                    if len(resolved_lines) >= 6:
                        break
                if resolved_lines and block_ok:
                    parts.append(
                        "REFERENT RESOLVED — these record(s) are the SPECIFIC item your "
                        "question names (its own bound text, same timestamp). If the asked "
                        "detail is present on THESE line(s), answer from them, and do NOT "
                        "take a name/detail from a different item below that merely shares "
                        "the genre word. If the asked detail is NOT on these line(s), use "
                        "the rest of the dossier as usual:")
                    parts.extend("  " + ln for ln in resolved_lines)
        parts.append("FRAME OBSERVATIONS: do not bind names/text across timestamps; use the "
                     "SAME-EVENT RELATIONS block above for cross-frame association.")
        for row in surfaced_entity_rows:
            timestamp = row.get("t")
            for person in row.get("persons") or []:
                if not isinstance(person, dict):
                    continue
                clothing = person.get("clothing") or {}
                details = []
                if isinstance(clothing, dict):
                    if clothing.get("top"):
                        details.append("top " + _flatten_text(clothing.get("top")))
                    if clothing.get("bottom"):
                        details.append("bottom " + _flatten_text(clothing.get("bottom")))
                    if clothing.get("colors"):
                        details.append("colors " + _flatten_text(clothing.get("colors")))
                if person.get("accessories"):
                    details.append("accessories " + _flatten_text(person.get("accessories")))
                if person.get("holding"):
                    details.append("holding " + _flatten_text(person.get("holding")))
                if person.get("position"):
                    details.append(_flatten_text(person.get("position")))
                appearance = _flatten_text(person.get("appearance")) or "person"
                line = "[t=%ss] PERSON: %s" % (timestamp, appearance)
                if details:
                    line += " — " + "; ".join(details)
                parts.append(_clip(line, 320))
            for obj in row.get("text_objects") or []:
                if not isinstance(obj, dict) or not obj.get("object"):
                    continue
                line = "[t=%ss] OBJECT: %s" % (timestamp, _flatten_text(obj.get("object")))
                if obj.get("logo_or_text"):
                    line += ' — logo/text: "%s"' % _flatten_text(obj.get("logo_or_text"))
                parts.append(_clip(line, 320))
            if row.get("is_self_view") and row.get("self_attributes"):
                parts.append(_clip("[t=%ss] SELF-VIEW: %s" %
                                   (timestamp, _flatten_text(row.get("self_attributes"))), 320))

        # Ask-specific absence evidence. A NOTE is licensed only when the question
        # names both a supported attribute and an entity actually present in the
        # surfaced rows. Attribute checks stay within that entity's own record.
        qlow = (question or "").lower()

        # Outfit questions need a temporal state, not a bag of every garment seen
        # all day. When capture itself labels a dressing/getting-ready sequence,
        # aggregate repeated SELF-view garments inside that sequence. This is a
        # general event-anchor rule: it uses the capture's own activity text and
        # cross-frame consensus, never a clip-specific timestamp or expected outfit.
        if (re.search(r"\b(outfit|wearing|wore|clothes|clothing)\b", qlow)
                and re.search(r"\b(i|my|me)\b", qlow)):
            garment_reads = {}

            def _canonical_garment(value):
                low = re.sub(r"[^a-z ]+", " ", str(value or "").lower())
                low = re.sub(r"\s+", " ", low).strip()
                colors = [c for c in (set(COLOUR_WORDS) | {"dark"})
                          if re.search(r"\b%s\b" % re.escape(c), low)]
                color = colors[0] if colors else ""
                if re.search(r"\b(t ?shirt|shirt|top|tee)\b", low) and color:
                    return color + " shirt"
                if re.search(r"\b(sweatpants|pants|trousers|joggers)\b", low):
                    noun = "sweatpants" if "sweatpants" in low else "pants"
                    return ((color + " ") if color else "") + noun
                if re.search(r"\b(crocs|shoes|sneakers|boots|sandals|socks)\b", low):
                    noun = next((n for n in ("crocs", "sneakers", "shoes", "boots", "sandals", "socks")
                                 if n in low), "")
                    return ((color + " ") if color else "") + noun
                return ""

            for row in entity_capture:
                event_text = " ".join(_flatten_text(o.get("logo_or_text"))
                                      for o in row.get("text_objects") or []
                                      if isinstance(o, dict)).lower()
                if not row.get("is_self_view") or not re.search(
                        r"\b(dress|dressed|dressing|outfit|clothes|wear)\w*\b", event_text):
                    continue
                values = []
                for person in row.get("persons") or []:
                    if not isinstance(person, dict):
                        continue
                    clothing = person.get("clothing") or {}
                    if isinstance(clothing, dict):
                        values.extend([clothing.get("top"), clothing.get("bottom")])
                for value in values:
                    garment = _canonical_garment(value)
                    if garment:
                        garment_reads.setdefault(garment, []).append(row.get("t"))
            consensus = sorted(garment_reads.items(), key=lambda item: (-len(item[1]), item[0]))
            if consensus:
                parts.append("SELF OUTFIT CONSENSUS from capture-labeled dressing frames: "
                             + "; ".join("%s (%d reads, t=%s)" %
                                         (garment, len(times), ",".join(str(t) for t in times))
                                         for garment, times in consensus[:6]))

        requested_attribute = None
        if re.search(r"\b(zip|zipper|zipped|unzipped)\b", qlow):
            requested_attribute = "zip/zipper state"
        elif re.search(r"\b(colou?r)\b", qlow):
            requested_attribute = "colour"
        elif re.search(r"\b(logo|brand)\b", qlow):
            requested_attribute = "logo"
        elif re.search(r"\b(top|shirt|jacket|coat)\b", qlow):
            requested_attribute = "top clothing"
        elif re.search(r"\b(bottom|trousers|pants|skirt)\b", qlow):
            requested_attribute = "bottom clothing"
        elif re.search(r"\b(holding|held|carrying)\b", qlow):
            requested_attribute = "held item"

        candidates = []
        for row in surfaced_entity_rows:
            for person in row.get("persons") or []:
                if not isinstance(person, dict):
                    continue
                appearance = _flatten_text(person.get("appearance"))
                if appearance:
                    candidates.append((appearance, person, "person"))
                for accessory in person.get("accessories") or []:
                    candidates.append((_flatten_text(accessory), accessory, "accessory"))
                for held in person.get("holding") or []:
                    candidates.append((_flatten_text(held), held, "held"))
            for obj in row.get("text_objects") or []:
                if isinstance(obj, dict) and obj.get("object"):
                    candidates.append((_flatten_text(obj.get("object")), obj, "object"))

        qtokens = set(_tokens(qlow))
        bag_aliases = {"bag", "backpack", "rucksack", "knapsack"}
        matched = []
        entity_name = None
        for label, record, kind in candidates:
            label_tokens = set(_tokens(label))
            exact = qtokens & label_tokens
            bag_match = bool(qtokens & bag_aliases and label_tokens & bag_aliases)
            if exact or bag_match:
                matched.append((label, record, kind))
                if entity_name is None:
                    entity_name = "bag" if bag_match and "bag" in qtokens else label

        def _candidate_has_attribute(candidate, attribute):
            _label, record, kind = candidate
            text = _flatten_text(record).lower()
            if attribute == "zip/zipper state":
                return (bool(re.search(r"\b(zip|zipper)\b", text)) and
                        bool(re.search(r"\b(open|closed|zipped|unzipped)\b", text)))
            if attribute == "colour":
                return bool(set(_tokens(text)) & COLOUR_WORDS)
            if attribute == "logo":
                return (kind == "object" and isinstance(record, dict)
                        and bool(record.get("logo_or_text")))
            if not isinstance(record, dict):
                return False
            clothing = record.get("clothing") or {}
            if attribute == "top clothing":
                return isinstance(clothing, dict) and bool(clothing.get("top"))
            if attribute == "bottom clothing":
                return isinstance(clothing, dict) and bool(clothing.get("bottom"))
            if attribute == "held item":
                return bool(record.get("holding"))
            return False

        if (requested_attribute and matched and
                not any(_candidate_has_attribute(c, requested_attribute) for c in matched)):
            parts.append(
                "NOTE: the entity-capture channel did not record a %s for %s. This is "
                "scoped to ONE channel only — if ANOTHER line below (OCR, region OCR, a "
                "bound memory, a persistent entity) reports it for that same item, answer "
                "from that line. Refuse only if NO channel reports it."
                % (requested_attribute, entity_name))

    # --- PERSISTENT ENTITIES (capture-bound, then cross-frame re-identified) -- #
    centric = [e for e in (channels.get("entity_centric") or []) if isinstance(e, dict)]
    if centric:
        qlow = (question or "").lower()
        third_party = bool(re.search(
            r"\b(who|person|people|someone|he|him|his|she|her|hers|they|them|their|"
            r"mate|friend|buddy|guy|man|woman|lady|opposite)\b", qlow))
        direct_self = bool(re.search(r"\b(i|my|me|mine)\b", qlow)) and not third_party

        def _centric_text(entity):
            attrs = entity.get("attributes") or []
            return "%s %s %s" % (
                entity.get("type", ""), entity.get("label", ""),
                " ".join("%s %s" % (a.get("attr", ""), a.get("value", ""))
                         for a in attrs if isinstance(a, dict)))

        candidates = ([e for e in centric if e.get("type") == "self"]
                      if direct_self else centric)
        ranked_entities = sorted(
            candidates,
            key=lambda e: (_referent_focus_hits(_centric_text(e), dtok_ref),
                           _focus_hits(_centric_text(e), dtok_ref),
                           _score_overlap(_centric_text(e), kw),
                           max((float(a.get("confidence") or 0.0)
                                for a in e.get("attributes") or []
                                if isinstance(a, dict)), default=0.0)),
            reverse=True)[:max_per_channel]
        if ranked_entities:
            parts.append("=== PERSISTENT ENTITIES (attributes stay on their owner) ===")
            for entity in ranked_entities:
                attrs = [a for a in entity.get("attributes") or [] if isinstance(a, dict)]
                ranked_attrs = sorted(
                    attrs,
                    key=lambda a: (_score_overlap("%s %s" %
                                                 (a.get("attr", ""), a.get("value", "")), kw),
                                   len(a.get("frames") or []),
                                   float(a.get("confidence") or 0.0)),
                    reverse=True)[:12]
                attr_text = "; ".join(
                    "%s=%s @%s" % (a.get("attr"), _flatten_text(a.get("value")),
                                     _flatten_text(a.get("frames") or []))
                    for a in ranked_attrs)
                parts.append(_clip("%s %s: %s" %
                                   ((entity.get("type") or "entity").upper(),
                                    entity.get("label") or entity.get("entity_id"), attr_text), 700))

            # Negative self evidence is safe only for explicit wearable nouns and a
            # direct first-person question. It stops another person's glasses/logo
            # from becoming the wearer's while leaving general outfit recall alone.
            if direct_self:
                wearable_terms = {"glasses", "eyewear", "spectacles", "watch", "wristwatch",
                                  "bracelet", "necklace", "ring", "hat", "cap", "earbuds"}
                asked = set(_tokens(qlow)) & wearable_terms
                self_blob = " ".join(_centric_text(e).lower() for e in candidates)
                missing = sorted(term for term in asked if term not in self_blob)
                if missing:
                    parts.append("NOTE: the persistent SELF entity has no recorded %s; do not "
                                 "transfer that item from another person to the wearer."
                                 % "/".join(missing))

    # --- SLEEP-PASS BOUND MEMORY (cross-channel entity bindings) ------------ #
    bound = channels.get("bound")
    if isinstance(bound, dict):
        bparts = []
        entities = bound.get("entities") or []
        if entities:
            def _bound_text(e):
                return "%s %s %s" % (
                    e.get("name", ""), e.get("kind", ""),
                    " ".join(e.get("evidence") or []))
            ranked_ents = sorted(
                entities, key=lambda e: _score_overlap(_bound_text(e), kw), reverse=True
            )[:max_per_channel]
            bparts.append("ENTITIES:")
            for e in ranked_ents:
                evs = "; ".join(e.get("evidence") or [])
                bparts.append("  %s (%s) — t=%s-%s: %s"
                              % (e.get("name"), e.get("kind"),
                                 e.get("t_range", [None])[0],
                                 (e.get("t_range") or [None, None])[1], evs))
        bindings = bound.get("bindings") or []
        if bindings:
            def _bind_text(b):
                return b if isinstance(b, str) else str(b)
            ranked_bindings = sorted(
                bindings, key=lambda b: _score_overlap(_bind_text(b), kw), reverse=True
            )[:max_per_channel]
            bparts.append("BINDINGS:")
            for b in ranked_bindings:
                bparts.append("  " + _bind_text(b))
        pc = bound.get("poster_count")
        if pc:
            names = ", ".join(pc.get("names") or [])
            bparts.append("POSTER COUNT: n=%s — %s" % (pc.get("n"), names))
        summary = bound.get("summary") or ""
        if summary and summary != "PARSE_ERROR":
            bparts.append("SUMMARY: " + summary)
        if bparts:
            parts.append("=== SLEEP-PASS BOUND MEMORY (entity cross-links) ===")
            parts.extend(bparts)

    # --- TIME / EPISODES ----------------------------------------------------- #
    episodes = channels.get("episodes") or []
    if episodes:
        parts.append("=== TIME / EPISODES ===")
        for ep in episodes:
            parts.append("- %s from %.1fs to %.1fs (%.1fs)"
                         % (ep.get("label"), ep.get("start", 0.0), ep.get("end", 0.0),
                            ep.get("duration", 0.0)))

    return "\n".join(parts), cited


